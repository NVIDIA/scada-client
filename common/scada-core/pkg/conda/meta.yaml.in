{% set deps = load_file_data('deps.json', from_recipe_dir = True) %}
package:
    name: "@PROJECT_NAME@"
    version : "@PROJECT_VERSION@"

source:
    git_rev: "main"
    git_url: "https://github.com/NVIDIA/scada-client.git"

requirements:
    build:
        - cmake
    run:
        - {{ compiler('cxx') }}
        - psa-result {{ deps['psa-result'] if 'psa-result' in deps }} 
        - psa-coaio {{ deps['psa-coaio'] if 'psa-coaio' in deps }} 
        - gdakis-utils {{ deps['gdakis-utils'] if 'gdakis-utils' in deps }}
        - gdakis-comm {{ deps['gdakis-comm'] if 'gdakis-comm' in deps }}