namespace tests {
struct process_handle {
    pid_t pid_;

    inline process_handle(pid_t pid) noexcept : pid_(pid) {}

    process_handle(const process_handle &) = delete;

    inline process_handle(process_handle && other) noexcept : pid_(other.pid_) { other.pid_ = -1; }

    inline ~process_handle() noexcept {
        if (pid_ < 0)
            return;

        ::kill(pid_, SIGTERM);
    }

    inline bool wait() const noexcept {
        int status = 0;
        int err = ::waitpid(pid_, &status, 0);
        if (err != pid_)
            return false;
        return WEXITSTATUS(status) == EXIT_SUCCESS;
    }

    inline void kill(int sig) const noexcept { ::kill(pid_, sig); }
};

template<typename _Fn>
static inline process_handle process(_Fn && fn) {
    pid_t pid = fork();
    if (pid != 0)
        return process_handle(pid);

    fn();
    if (::testing::Test::HasFatalFailure()) {
        ::exit(EXIT_FAILURE);
    }
    ::exit(EXIT_SUCCESS);
}

template<typename _Tp>
class shmem {
protected:
    std::shared_ptr<_Tp> mem_;

    inline shmem(std::shared_ptr<_Tp> && mem) noexcept : mem_(std::move(mem)) {}

public:
    inline shmem(shmem &&) noexcept = default;

    inline _Tp & get() const noexcept { return *mem_.get(); }

    template<typename... Args>
    static inline psa::result<shmem, int> make(Args &&... args) noexcept {
        using result_type = psa::result<shmem, int>;

        _Tp * raw = reinterpret_cast<_Tp *>(
            ::mmap(0, sizeof(_Tp), PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANONYMOUS, -1, 0));
        if (raw == reinterpret_cast<_Tp *>(MAP_FAILED))
            return result_type::err(errno);

        new (raw) _Tp(std::forward<Args>(args)...);

        return result_type::ok(shmem(std::shared_ptr<_Tp>(raw, [](_Tp * ptr) { ::munmap(ptr, sizeof(_Tp)); })));
    }
};

}

