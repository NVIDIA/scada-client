class CUDATest : public ::testing::Test {
protected:
    void SetUp() override {
        int gpu_count = 0;
        if (cudaGetDeviceCount(&gpu_count) != cudaSuccess or gpu_count <= 0) {
            GTEST_SKIP() << "No CUDA capable GPUs present. Skipping GPU tests";
        }
    }
};

struct CudaMemSnapshot {
    std::size_t free_bytes;
    std::size_t total_bytes;
};

static inline bool cuda_mem_log_enabled() {
    return std::getenv("SCADA_CUDA_MEM_LOG") != nullptr;
}

static inline CudaMemSnapshot cuda_mem_snapshot(const char * label) {
    std::size_t free_bytes = 0;
    std::size_t total_bytes = 0;
    auto cuda_ret = cudaMemGetInfo(&free_bytes, &total_bytes);
    if (cuda_ret != cudaSuccess) {
        EXPECT_EQ(cuda_ret, cudaSuccess);
        return { 0, 0 };
    }
    if (cuda_mem_log_enabled()) {
        std::cout << "[mem] " << label << " free=" << free_bytes << " total=" << total_bytes << std::endl;
    }
    return { free_bytes, total_bytes };
}

static inline void cuda_mem_log_delta(const char * label, const CudaMemSnapshot & begin, const CudaMemSnapshot & end) {
    if (!cuda_mem_log_enabled()) {
        return;
    }
    auto delta = static_cast<long long>(end.free_bytes) - static_cast<long long>(begin.free_bytes);
    std::cout << "[mem] " << label << " delta_free=" << delta << " bytes" << std::endl;
}

class CudaMemLogScope {
public:
    explicit CudaMemLogScope(const char * label) : label_(label), enabled_(cuda_mem_log_enabled()) {
        if (!enabled_) {
            return;
        }
        begin_ = capture();
        log_snapshot("begin", begin_);
    }

    ~CudaMemLogScope() {
        if (!enabled_) {
            return;
        }
        auto end = capture();
        log_snapshot("end", end);
        cuda_mem_log_delta(label_, begin_, end);
    }

private:
    static CudaMemSnapshot capture() {
        std::size_t free_bytes = 0;
        std::size_t total_bytes = 0;
        auto cuda_ret = cudaMemGetInfo(&free_bytes, &total_bytes);
        if (cuda_ret != cudaSuccess) {
            EXPECT_EQ(cuda_ret, cudaSuccess);
            return { 0, 0 };
        }
        return { free_bytes, total_bytes };
    }

    void log_snapshot(const char * phase, const CudaMemSnapshot & snapshot) const {
        if (label_ == nullptr || label_[0] == '\0') {
            std::cout << "[mem] " << phase << " free=" << snapshot.free_bytes << " total=" << snapshot.total_bytes
                      << std::endl;
            return;
        }
        std::cout << "[mem] " << label_ << " " << phase << " free=" << snapshot.free_bytes
                  << " total=" << snapshot.total_bytes << std::endl;
    }

    const char * label_;
    bool enabled_;
    CudaMemSnapshot begin_ { 0, 0 };
};

}
