[repo]
logging = "warn"


[repo_docs]
enabled = true
project = "gdakis-utils"
name = "GDAKIS Utils"
version = "@PROJECT_VERSION@"
copyright_start = 2022

docs_root = "docs"
logo = "images/NVIDIA_logo.png"

sphinx_conf_py_extra = """
    numfig = True
"""

only_preprocessor_enabled = true

doxygen_input = [
    "@CMAKE_SOURCE_DIR@/include/gdakis/atomic",
    "@CMAKE_SOURCE_DIR@/include/gdakis/barrier",
    "@CMAKE_SOURCE_DIR@/include/gdakis/bitmap",
    "@CMAKE_SOURCE_DIR@/include/gdakis/bits",
    "@CMAKE_SOURCE_DIR@/include/gdakis/log2",
    "@CMAKE_SOURCE_DIR@/include/gdakis/mpbar",
    "@CMAKE_SOURCE_DIR@/include/gdakis/seqlock",
    "@CMAKE_SOURCE_DIR@/include/gdakis/spinbar",
    "@CMAKE_SOURCE_DIR@/include/gdakis/spinlock",
    "@CMAKE_SOURCE_DIR@/include/gdakis/thread",
    "@CMAKE_SOURCE_DIR@/include/gdakis/cuda/asm",
    "@CMAKE_SOURCE_DIR@/include/gdakis/cuda/regs",
]
doxygen_dst = "@PROJECT_BINARY_DIR@/tmp"
doxygen_strip_from_path = [
    "@PROJECT_SOURCE_DIR@/include"
]
doxygen_conf_extra = """
   SEARCH_INCLUDES = YES
   EXTENSION_MAPPING = "no_extension=C++"
   INCLUDE_PATH = @CMAKE_SOURCE_DIR@/include
   PREDEFINED = __DOXYGEN__
   ENABLE_PREPROCESSING = YES
   SKIP_FUNCTION_MACROS = NO
   MACRO_EXPANSION = YES
   EXTRACT_ANON_NSPACES = NO
"""

api_title = "GDAKIS Utils"
api_output_directory = "docs/_build/api"
api_item_filters = [
    { rule = "exclude", attribute = "protection",   matching = "protected"},
    { rule = "exclude", attribute = "kind",         matching = "file"},
    { rule = "exclude", attribute = "kind",         matching = "dir"},
    { rule = "exclude", attribute = "kind",         matching = "define"},
]
api_root_page = {}
api_toc_pages = [
   {docname = "namespaces", title = "Namespace", kinds = ["namespace"]},
   {docname = "classes", title = "Class List", kinds = ["class"]},
]