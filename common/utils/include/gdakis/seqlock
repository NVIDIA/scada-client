#ifndef GDAKIS_SEQLOCK
#define GDAKIS_SEQLOCK

#include <gdakis/__utils_cuda_compat>
#include <gdakis/__utils_version>
#include <gdakis/atomic>

//! @file gdakis/seqlock

GDAKIS_UTILS_SIMPLE_NS {
GDAKIS_UTILS_UNIT(seqlock) {

//! @brief A sequential-lock implementation
//! @tparam _Sco Synchronization scope
template<thread_scope _Sco>
class seqlock {
protected:
    //! @brief Current count
    atomic<unsigned, _Sco> current_;
    //! @brief Value to assign to the next thread locking
    atomic<unsigned, _Sco> ticket_;
#if !defined(NDEBUG)
    //! @brief ID of the thread that is currently holding the lock
    atomic<unsigned, _Sco> thread_id_;

    //! @brief Block ID of the thread that is currently holding the lock
    atomic<unsigned, _Sco> block_id_;
#endif

    //! @brief Maximum number of nanoseconds to spin while polling
    static const size_t max_delay = 512;

    //! @brief Execute a CPU read critical section that returns a value
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param fn Read critical section functor
    //! @param ...args Arguments to forward to the critical section
    //! @return Return value of the critical section
    template<typename _Fn, typename... Args>
    __host__ std::enable_if_t<!std::is_void_v<std::invoke_result_t<_Fn, Args...>>, std::invoke_result_t<_Fn, Args...>>
    __host_read_critical_section(_Fn && fn, Args &&... args) noexcept;

    //! @brief Execute a CPU read critical section without return value
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param fn Read critical section functor
    //! @param ...args Arguments to forward to the critical section
    template<typename _Fn, typename... Args>
    __host__ std::enable_if_t<std::is_void_v<std::invoke_result_t<_Fn, Args...>>> __host_read_critical_section(
        _Fn && fn, Args &&... args) noexcept;

#if defined(__CUDACC__) or defined(__DOXYGEN__)
    //! @brief Execute a CUDA read critical section that returns a value
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param cg Cooperative group calling the operation synchronously
    //! @param fn Read critical section functor
    //! @param ...args Arguments to forward to the critical section
    //! @return Return value of the critical section
    template<typename _Cg, typename _Fn, typename... Args>
    __device__ std::enable_if_t<!std::is_void_v<std::invoke_result_t<_Fn, Args...>>, std::invoke_result_t<_Fn, Args...>>
    __device_read_critical_section(const _Cg & cg, _Fn && fn, Args &&... args) noexcept;

    //! @brief Execute a CUDA read critical section without return value
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param cg Cooperative group calling the operation synchronously
    //! @param fn Read critical section functor
    //! @param ...args Arguments to forward to the critical section
    template<typename _Cg, typename _Fn, typename... Args>
    __device__ std::enable_if_t<std::is_void_v<std::invoke_result_t<_Fn, Args...>>> __device_read_critical_section(
        const _Cg & cg, _Fn && fn, Args &&... args) noexcept;

    //! @brief Execute a CUDA read critical section that returns a value that threads in the warp execute in parallel
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param cg Cooperative group calling the operation synchronously
    //! @param fn Read critical section functor
    //! @param ...args Arguments to forward to the critical section
    //! @return Return value of the critical section
    template<typename _Cg, typename _Fn, typename... Args>
    __device__ std::enable_if_t<!std::is_void_v<std::invoke_result_t<_Fn, Args...>>, std::invoke_result_t<_Fn, Args...>>
    __device_read_parallel_critical_section(const _Cg & cg, _Fn && fn, Args &&... args) noexcept;

    //! @brief Execute a CUDA read critical section without return value that threads in the warp execute in parallel
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param cg Cooperative group calling the operation synchronously
    //! @param fn Read critical section functor
    //! @param ...args Arguments to forward to the critical section
    template<typename _Cg, typename _Fn, typename... Args>
    __device__ std::enable_if_t<std::is_void_v<std::invoke_result_t<_Fn, Args...>>>
    __device_read_parallel_critical_section(const _Cg & cg, _Fn && fn, Args &&... args) noexcept;

    //! @brief Execute a CUDA read critical section that returns a value that threads in the warp execute sequentially
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param cg Cooperative group calling the operation synchronously
    //! @param fn Read critical section functor
    //! @param ...args Arguments to forward to the critical section
    //! @return Return value of the critical section
    template<typename _Cg, typename _Fn, typename... Args>
    __device__ std::enable_if_t<!std::is_void_v<std::invoke_result_t<_Fn, Args...>>, std::invoke_result_t<_Fn, Args...>>
    __device_read_single_thread_critical_section(const _Cg & cg, _Fn && fn, Args &&... args) noexcept;

    //! @brief Execute a CUDA read critical section without return value that threads in the warp execute sequentially
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param cg Cooperative group calling the operation synchronously
    //! @param fn Read critical section functor
    //! @param ...args Arguments to forward to the critical section
    template<typename _Cg, typename _Fn, typename... Args>
    __device__ std::enable_if_t<std::is_void_v<std::invoke_result_t<_Fn, Args...>>>
    __device_read_single_thread_critical_section(const _Cg & cg, _Fn && fn, Args &&... args) noexcept;

#endif

    //! @brief Execute a CPU write critical section that returns a value
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param fn Read critical section functor
    //! @param ...args Arguments to forward to the critical section
    //! @return Return value of the critical section
    template<typename _Fn, typename... Args>
    __host__ std::enable_if_t<!std::is_void_v<std::invoke_result_t<_Fn, Args...>>, std::invoke_result_t<_Fn, Args...>>
    __host_write_critical_section(_Fn && fn, Args &&... args) noexcept;

    //! @brief Execute a CPU write critical section without return value
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param fn Read critical section functor
    //! @param ...args Arguments to forward to the critical section
    template<typename _Fn, typename... Args>
    __host__ std::enable_if_t<std::is_void_v<std::invoke_result_t<_Fn, Args...>>> __host_write_critical_section(
        _Fn && fn, Args &&... args) noexcept;

#if defined(__CUDACC__)
    //! @brief Execute a CUDA write critical section that returns a value
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param cg Cooperative group calling the operation synchronously
    //! @param fn Read critical section functor
    //! @param ...args Arguments to forward to the critical section
    //! @return Return value of the critical section
    template<typename _Cg, typename _Fn, typename... Args>
    __device__ std::enable_if_t<!std::is_void_v<std::invoke_result_t<_Fn, Args...>>, std::invoke_result_t<_Fn, Args...>>
    __device_write_critical_section(const _Cg & cg, _Fn && fn, Args &&... args) noexcept;

    //! @brief Execute a CUDA write critical section without return value
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param cg Cooperative group calling the operation synchronously
    //! @param fn Read critical section functor
    //! @param ...args Arguments to forward to the critical section
    template<typename _Cg, typename _Fn, typename... Args>
    __device__ std::enable_if_t<std::is_void_v<std::invoke_result_t<_Fn, Args...>>> __device_write_critical_section(
        const _Cg & cg, _Fn && fn, Args &&... args) noexcept;

    //! @brief Execute a CUDA write critical section that returns a value that threads in the warp execute in parallel
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param cg Cooperative group calling the operation synchronously
    //! @param fn Read critical section functor
    //! @param ...args Arguments to forward to the critical section
    //! @return Return value of the critical section
    template<typename _Cg, typename _Fn, typename... Args>
    __device__ std::enable_if_t<!std::is_void_v<std::invoke_result_t<_Fn, Args...>>, std::invoke_result_t<_Fn, Args...>>
    __device_write_single_thread_critical_section(const _Cg & cg, _Fn && fn, Args &&... args) noexcept;

    //! @brief Execute a CUDA write critical section without return value that threads in the warp execute in parallel
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param cg Cooperative group calling the operation synchronously
    //! @param fn Read critical section functor
    //! @param ...args Arguments to forward to the critical section
    template<typename _Cg, typename _Fn, typename... Args>
    __device__ std::enable_if_t<std::is_void_v<std::invoke_result_t<_Fn, Args...>>>
    __device_write_single_thread_critical_section(const _Cg & cg, _Fn && fn, Args &&... args) noexcept;
#endif

    //! @brief Spin for a given number of nanosecond
    //! @param delay Number of nanoseconds to spin for
    __host__ __device__ inline void busy_wait(unsigned delay) noexcept;

public:
    //! @brief Default constructor
    __host__ __device__ seqlock() noexcept;

    //! @brief Explicit initialization for uninitialized objects
    __host__ __device__ void init() noexcept;

    //! @brief Execute a read critical section that returns a value
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param fn Read critical section functor
    //! @param ...args Arguments to forward to the critical section
    //! @return Return value of the critical section
    template<typename _Fn, typename... Args>
    __host__ __device__ std::invoke_result_t<_Fn, Args...> read_critical_section(_Fn && fn, Args &&... args) noexcept;

    //! @brief Acquire the lock for read
    //! @return Acquisition token
    __host__ __device__ inline unsigned read_lock() const noexcept;

    //! @brief Release the lock for read
    //! @return Release token
    __host__ __device__ inline unsigned read_unlock() const noexcept;

    //! @brief Execute a write critical section
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param fn Read critical section functor
    //! @param ...args Arguments to forward to the critical section
    //! @return Return value of the critical section
    template<typename _Fn, typename... Args>
    __host__ __device__ std::invoke_result_t<_Fn, Args...> write_critical_section(_Fn && fn, Args &&... args) noexcept;

    //! @brief Acquire the lock for write
    __host__ __device__ inline void write_lock() noexcept;

    //! @brief Release the lock for write
    __host__ __device__ inline void write_unlock() noexcept;

#if defined(__CUDACC__) || defined(__DOXYGEN__)

    /** Device-only API */

    //! @brief Execute a read critical section that returns a value
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param g Cooperative group calling the operation synchronously
    //! @param fn Read critical section functor
    //! @param ...args Arguments to forward to the critical section
    //! @return Return value of the critical section
    template<typename _Cg, typename _Fn, typename... Args>
    __device__ std::invoke_result_t<_Fn, Args...> read_critical_section(
        const _Cg & g, _Fn && fn, Args &&... args) noexcept;

    //! @brief Execute a read critical section that returns a value that several threads execute in parallel
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param g Cooperative group calling the operation synchronously
    //! @param fn Read critical section functor
    //! @param ...args Arguments to forward to the critical section
    //! @return Return value of the critical section
    template<typename _Cg, typename _Fn, typename... Args>
    __device__ std::invoke_result_t<_Fn, Args...> read_parallel_critical_section(
        const _Cg & g, _Fn && fn, Args &&... args) noexcept;

    //! @brief Execute a read critical section by a single thread that will broadcast result to the rest of the group
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param cg Cooperative group calling the operation synchronously
    //! @param fn Read critical section functor
    //! @param ...args Arguments to forward to the critical section
    //! @return Return value of the critical section
    template<typename _Cg, typename _Fn, typename... Args>
    __device__ std::invoke_result_t<_Fn, Args...> read_single_thread_critical_section(
        const _Cg & cg, _Fn && fn, Args &&... args) noexcept;

    //! @brief Acquire the lock for read from multiple threads in a warp
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @param cg Cooperative group calling the operation synchronously
    //! @return Acquisition token
    template<typename _Cg>
    __device__ inline unsigned read_lock(const _Cg & cg) const noexcept;

    //! @brief Acquire the lock for read from multiple threads in a warp
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @param cg Cooperative group calling the operation synchronously
    //! @return Acquisition token
    template<typename _Cg>
    __device__ inline unsigned read_parallel_lock(const _Cg & cg) const noexcept;

    //! @brief Release the lock for read from multiple threads in a warp
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @param cg Cooperative group calling the operation synchronously
    //! @return Release token
    template<typename _Cg>
    __device__ inline unsigned read_unlock(const _Cg & cg) const noexcept;

    //! @brief Execute a write critical section
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param cg Cooperative group calling the operation synchronously
    //! @param fn Write critical section functor
    //! @param ...args Arguments to forward to the critical section
    //! @return Return value of the critical section
    template<typename _Cg, typename _Fn, typename... Args>
    __device__ std::invoke_result_t<_Fn, Args...> write_critical_section(
        const _Cg & cg, _Fn && fn, Args &&... args) noexcept;

    //! @brief Execute a write critical section and only allow one calling thread at a time
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @tparam _Fn Functor type implementing the critical section
    //! @tparam Args Argument types passed to the critical section functor
    //! @param cg Cooperative group calling the operation synchronously
    //! @param fn Write critical section functor
    //! @param ...args Arguments to forward to the critical section
    //! @return Return value of the critical section
    template<typename _Cg, typename _Fn, typename... Args>
    __device__ std::invoke_result_t<_Fn, Args...> write_single_thread_critical_section(
        const _Cg & cg, _Fn && fn, Args &&... args) noexcept;

    //! @brief Acquire the lock for write from multiple threads in a warp
    //! @tparam _Cg Type of the cooperative group calling the operation
    //! @param cg Cooperative group calling the operation synchronously
    template<typename _Cg>
    __device__ inline void write_lock(const _Cg & cg) noexcept;

#endif
};

}}

#include "impl/seqlock"

GDAKIS_UTILS_SIMPLE_EXPORT_NS(gdakis, seqlock)

#endif