#ifndef GDAKIS_IMPL_THREAD
#define GDAKIS_IMPL_THREAD

#include <chrono>
#include <thread>

GDAKIS_UTILS_SIMPLE_NS {
GDAKIS_UTILS_UNIT(thread) {

inline __host__ __device__ void this_thread::nanosleep(unsigned n) noexcept {
#if defined(__CUDA_ARCH__)
    __nanosleep(n);
#else
    std::this_thread::sleep_for(std::chrono::nanoseconds(n));
#endif
}

}}

#endif