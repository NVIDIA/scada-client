GDAKIS_UTILS_UNIT(seqlock) {

namespace detail {

template<typename _Fn, size_t... Is>
__host__ __device__ static inline constexpr auto __index_apply_impl(_Fn f, std::index_sequence<Is...>) noexcept {
    return f(std::integral_constant<size_t, Is> {}...);
}

template<size_t N, typename _Fn>
__host__ __device__ static inline constexpr auto __index_apply(_Fn f) noexcept {
    return __index_apply_impl(f, std::make_index_sequence<N> {});
}

template<typename Tuple, typename _Fn>
__host__ __device__ static inline constexpr auto __apply(Tuple t, _Fn f) noexcept {
    return __index_apply<std::tuple_size<Tuple> {}>([&](auto... Is) { return f(std::get<Is>(t)...); });
}

}

template<thread_scope _Sco>
inline __host__ __device__ seqlock<_Sco>::seqlock() noexcept
    : current_(0),
      ticket_(0)
#if !defined(NDEBUG)
      ,
      thread_id_(static_cast<unsigned>(-1)),
      block_id_(static_cast<unsigned>(-1))
#endif
{
}

template<thread_scope _Sco>
inline __host__ __device__ void seqlock<_Sco>::init() noexcept {
    current_.store(0);
    ticket_.store(0);
}

template<thread_scope _Sco>
template<typename _Fn, typename... Args>
inline
    __host__ std::enable_if_t<!std::is_void_v<std::invoke_result_t<_Fn, Args...>>, std::invoke_result_t<_Fn, Args...>>
    seqlock<_Sco>::__host_read_critical_section(_Fn && fn, Args &&... args) noexcept {
    unsigned before, after;
    std::invoke_result_t<_Fn, Args...> ret;

    do {
        before = read_lock();
        ret = fn(std::forward<Args>(args)...);
        after = read_unlock();
    } while (before != after);

    return ret;
}

template<thread_scope _Sco>
template<typename _Fn, typename... Args>
inline __host__ std::enable_if_t<std::is_void_v<std::invoke_result_t<_Fn, Args...>>>
seqlock<_Sco>::__host_read_critical_section(_Fn && fn, Args &&... args) noexcept {
    unsigned before, after;

    do {
        before = read_lock();
        fn(std::forward<Args>(args)...);
        after = read_unlock();
    } while (before != after);
}

template<thread_scope _Sco>
template<typename _Fn, typename... Args>
__host__ __device__ inline std::invoke_result_t<_Fn, Args...> seqlock<_Sco>::read_critical_section(
    _Fn && fn, Args &&... args) noexcept {
#if defined(__CUDA_ARCH__)
    return __device_read_critical_section(
        cooperative_groups::coalesced_threads(), std::forward<_Fn>(fn), std::forward<Args>(args)...);
#else
    return __host_read_critical_section(std::forward<_Fn>(fn), std::forward<Args>(args)...);
#endif
}

template<thread_scope _Sco>
__host__ __device__ inline unsigned seqlock<_Sco>::read_lock() const noexcept {
    unsigned ticket = current_.load(memory_order_acquire);

    return ticket & ~0x1;
}

template<thread_scope _Sco>
__host__ __device__ inline unsigned seqlock<_Sco>::read_unlock() const noexcept {
    atomic_thread_fence(memory_order_acq_rel, _Sco);
    return current_.load(memory_order_relaxed);
}

template<thread_scope _Sco>
template<typename _Fn, typename... Args>
inline
    __host__ std::enable_if_t<!std::is_void_v<std::invoke_result_t<_Fn, Args...>>, std::invoke_result_t<_Fn, Args...>>
    seqlock<_Sco>::__host_write_critical_section(_Fn && fn, Args &&... args) noexcept {
    write_lock();
    auto ret = fn(std::forward<Args>(args)...);
    write_unlock();

    return ret;
}

template<thread_scope _Sco>
template<typename _Fn, typename... Args>
inline __host__ std::enable_if_t<std::is_void_v<std::invoke_result_t<_Fn, Args...>>>
seqlock<_Sco>::__host_write_critical_section(_Fn && fn, Args &&... args) noexcept {
    write_lock();
    fn(std::forward<Args>(args)...);
    write_unlock();
}

template<thread_scope _Sco>
template<typename _Fn, typename... Args>
__host__ __device__ inline std::invoke_result_t<_Fn, Args...> seqlock<_Sco>::write_critical_section(
    _Fn && fn, Args &&... args) noexcept {
#if defined(__CUDA_ARCH__)
    return __device_write_critical_section(
        cooperative_groups::coalesced_threads(), std::forward<_Fn>(fn), std::forward<Args>(args)...);
#else
    return __host_write_critical_section(std::forward<_Fn>(fn), std::forward<Args>(args)...);
#endif
}

template<thread_scope _Sco>
__host__ __device__ inline void seqlock<_Sco>::busy_wait(unsigned ticket) noexcept {
    unsigned current = current_.load(memory_order_acquire);
    while (current != ticket) {
        // This is what empirically seems to maximize the throughput of the radix-tree
        unsigned delay = (ticket - current) >> 1;
        this_thread::nanosleep(delay);
        current = current_.load(memory_order_acquire);
    }
    current_.fetch_add(1, memory_order_release);
}

template<thread_scope _Sco>
__host__ __device__ inline void seqlock<_Sco>::write_lock() noexcept {
    busy_wait(ticket_.fetch_add(2));
#if !defined(NDEBUG) && defined(__CUDA_ARCH__)
    thread_id_.store(threadIdx.x, memory_order_relaxed);
    block_id_.store(blockIdx.x, memory_order_release);
#endif
}

template<thread_scope _Sco>
__host__ __device__ inline void seqlock<_Sco>::write_unlock() noexcept {
#if !defined(NDEBUG)
    unsigned current =
#endif
        current_.fetch_add(1, memory_order_release);
    assert(ticket_.load(memory_order_acquire) > current);
}

