template<thread_scope _Sco>
template<typename _Cg, typename _Fn, typename... Args>
inline
    __device__ std::enable_if_t<!std::is_void_v<std::invoke_result_t<_Fn, Args...>>, std::invoke_result_t<_Fn, Args...>>
    seqlock<_Sco>::__device_write_critical_section(const _Cg & g, _Fn && fn, Args &&... args) noexcept {
    std::invoke_result_t<_Fn, Args...> ret;
#  if !defined(NDEBUG)
    {
        int pred;
        assert(g.match_all(reinterpret_cast<uintptr_t>(this), pred) != 0);
    }
#  endif

    unsigned id = g.thread_rank();

    cooperative_groups::invoke_one(g, [this] { write_lock(); });

    for (unsigned n = 0; n < g.num_threads(); ++n) {
        if (n == id)
            ret = fn(std::forward<Args>(args)...);
        g.sync();
    }

    cooperative_groups::invoke_one(g, [this] { write_unlock(); });
    return ret;
}

template<thread_scope _Sco>
template<typename _Cg, typename _Fn, typename... Args>
inline __device__ std::enable_if_t<std::is_void_v<std::invoke_result_t<_Fn, Args...>>>
seqlock<_Sco>::__device_write_critical_section(const _Cg & g, _Fn && fn, Args &&... args) noexcept {
#  if !defined(NDEBUG)
    {
        int pred;
        assert(g.match_all(reinterpret_cast<uintptr_t>(this), pred) != 0);
    }
#  endif
    unsigned id = g.thread_rank();

    cooperative_groups::invoke_one(g, [this] { write_lock(); });
    for (unsigned n = 0; n < g.num_threads(); ++n) {
        if (n == id)
            fn(std::forward<Args>(args)...);
        g.sync();
    }
    cooperative_groups::invoke_one(g, [this] { write_unlock(); });
}

template<thread_scope _Sco>
template<typename _Cg, typename _Fn, typename... Args>
inline
    __device__ std::enable_if_t<!std::is_void_v<std::invoke_result_t<_Fn, Args...>>, std::invoke_result_t<_Fn, Args...>>
    seqlock<_Sco>::__device_write_single_thread_critical_section(const _Cg & g, _Fn && fn, Args &&... args) noexcept {
    std::invoke_result_t<_Fn, Args...> ret;

#  if !defined(NDEBUG)
    {
        int pred;
        assert(g.match_all(reinterpret_cast<uintptr_t>(this), pred) != 0);
    }
#  endif

    ret = cooperative_groups::invoke_one_broadcast(g, [this, fn, tuple = std::make_tuple(std::forward<Args>(args)...)] {
        std::invoke_result_t<_Fn, Args...> ret;

        write_lock();
        ret = detail::__apply(tuple, fn);
        write_unlock();

        return ret;
    });
    return ret;
}

template<thread_scope _Sco>
template<typename _Cg, typename _Fn, typename... Args>
inline __device__ std::enable_if_t<std::is_void_v<std::invoke_result_t<_Fn, Args...>>>
seqlock<_Sco>::__device_write_single_thread_critical_section(const _Cg & g, _Fn && fn, Args &&... args) noexcept {
#  if !defined(NDEBUG)
    {
        int pred;
        assert(g.match_all(reinterpret_cast<uintptr_t>(this), pred) != 0);
    }
#  endif
    cooperative_groups::invoke_one(g, [this, fn, tuple = std::make_tuple(std::forward<Args>(args)...)] {
        write_lock();
        detail::__apply(tuple, fn);
        write_unlock();
    });
}

template<thread_scope _Sco>
template<typename _Cg, typename _Fn, typename... Args>
__device__ inline std::invoke_result_t<_Fn, Args...> seqlock<_Sco>::write_critical_section(
    const _Cg & g, _Fn && fn, Args &&... args) noexcept {
    return __device_write_critical_section(g, std::forward<_Fn>(fn), std::forward<Args>(args)...);
}
template<thread_scope _Sco>
template<typename _Cg, typename _Fn, typename... Args>
__device__ inline std::invoke_result_t<_Fn, Args...> seqlock<_Sco>::write_single_thread_critical_section(
    const _Cg & g, _Fn && fn, Args &&... args) noexcept {
    return __device_write_single_thread_critical_section(g, std::forward<_Fn>(fn), std::forward<Args>(args)...);
}

template<thread_scope _Sco>
template<typename _Cg>
__device__ inline void seqlock<_Sco>::write_lock(const _Cg & g) noexcept {
    unsigned id, ticket;

    id = g.thread_rank();
    ticket
        = cooperative_groups::invoke_one_broadcast(g, [this, &g] { return ticket_.fetch_add(g.num_threads() << 1); });
    ticket += (id << 1);
    busy_wait(ticket);
#  if !defined(NDEBUG)
    thread_id_.store(threadIdx.x, memory_order_relaxed);
    block_id_.store(blockIdx.x, memory_order_release);
#  endif
}

