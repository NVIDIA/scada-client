seqlock<_Sco>::__device_read_parallel_critical_section(const _Cg & g, _Fn && fn, Args &&... args) noexcept {
    __device_read_critical_section(g, std::forward<_Fn>(fn), std::forward<Args>(args)...);
}

template<thread_scope _Sco>
template<typename _Cg, typename _Fn, typename... Args>
inline
    __device__ std::enable_if_t<!std::is_void_v<std::invoke_result_t<_Fn, Args...>>, std::invoke_result_t<_Fn, Args...>>
    seqlock<_Sco>::__device_read_single_thread_critical_section(const _Cg & g, _Fn && fn, Args &&... args) noexcept {
    std::invoke_result_t<_Fn, Args...> ret;

#  if !defined(NDEBUG)
    {
        int pred;
        assert(g.match_all(reinterpret_cast<uintptr_t>(this), pred) != 0);
    }
#  endif

    ret = cooperative_groups::invoke_one_broadcast(g, [this, fn, tuple = std::make_tuple(std::forward<Args>(args)...)] {
        unsigned before, after;
        std::invoke_result_t<_Fn, Args...> ret;
        do {
            before = read_lock();
            ret = detail::__apply(tuple, fn);
            after = read_unlock();
        } while (before != after);

        return ret;
    });
    g.sync();
    return ret;
}

template<thread_scope _Sco>
template<typename _Cg, typename _Fn, typename... Args>
inline __device__ std::enable_if_t<std::is_void_v<std::invoke_result_t<_Fn, Args...>>>
seqlock<_Sco>::__device_read_single_thread_critical_section(const _Cg & g, _Fn && fn, Args &&... args) noexcept {
#  if !defined(NDEBUG)
    {
        int pred;
        assert(g.match_all(reinterpret_cast<uintptr_t>(this), pred) != 0);
    }
#  endif

    cooperative_groups::invoke_one(g, [this, fn, tuple = std::make_tuple(std::forward<Args>(args)...)] {
        unsigned before, after;
        do {
            before = read_lock();
            detail::__apply(tuple, fn);
            after = read_unlock();
        } while (before != after);
    });
    g.sync();
}

