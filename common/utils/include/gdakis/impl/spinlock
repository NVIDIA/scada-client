namespace detail {

template<typename _Fn, size_t... Is>
__host__ __device__ static inline constexpr auto index_apply_impl(_Fn f, std::index_sequence<Is...>) noexcept {
    return f(std::integral_constant<size_t, Is> {}...);
}

template<size_t N, typename _Fn>
__host__ __device__ static inline constexpr auto index_apply(_Fn f) {
    return index_apply_impl(f, std::make_index_sequence<N> {});
}

template<typename Tuple, typename _Fn>
__host__ __device__ static inline constexpr auto apply(Tuple t, _Fn f) {
    return index_apply<std::tuple_size<Tuple> {}>([&](auto... Is) { return f(std::get<Is>(t)...); });
}

}

template<thread_scope _Sco>
template<typename _Cg, typename _Fn, typename... Args>
inline
    __device__ std::enable_if_t<!std::is_void_v<std::invoke_result_t<_Fn, Args...>>, std::invoke_result_t<_Fn, Args...>>
    spinlock<_Sco>::__device_single_thread_critical_section(const _Cg & g, _Fn && fn, Args &&... args) noexcept {
    std::invoke_result_t<_Fn, Args...> ret;

#  if !defined(NDEBUG)
    {
        int pred;
        assert(g.match_all(reinterpret_cast<uintptr_t>(this), pred) != 0);
    }
#  endif

    ret = cooperative_groups::invoke_one_broadcast(g, [this, fn, tuple = std::make_tuple(std::forward<Args>(args)...)] {
        unsigned ticket, current;
        unsigned delay = 1;
        std::invoke_result_t<_Fn, Args...> ret;

        ticket = ticket_.fetch_add(1);
        do {
            current = current_.load(memory_order_acquire);
            if (is_locked(delay, current, ticket)) {
#  if !defined(NDEBUG)
                thread_id_.store(threadIdx.x, memory_order_relaxed);
                block_id_.store(blockIdx.x, memory_order_release);
#  endif
                ret = detail::apply(tuple, fn);
                current_.fetch_add(1, memory_order_release);
            }
        } while (current != ticket);
        return ret;
    });
    return ret;
}

template<thread_scope _Sco>
template<typename _Cg, typename _Fn, typename... Args>
inline
    __device__ std::enable_if_t<std::is_void_v<std::invoke_result_t<_Fn, Args...>>, std::invoke_result_t<_Fn, Args...>>
    spinlock<_Sco>::__device_single_thread_critical_section(const _Cg & g, _Fn && fn, Args &&... args) noexcept {
#  if !defined(NDEBUG)
    {
        int pred;
        assert(g.match_all(reinterpret_cast<uintptr_t>(this), pred) != 0);
    }
#  endif

    cooperative_groups::invoke_one(g, [this, fn, tuple = std::make_tuple(std::forward<Args>(args)...)] {
        unsigned ticket, current;
        unsigned delay = 1;

        ticket = ticket_.fetch_add(1);
        do {
            current = current_.load(memory_order_acquire);
            if (is_locked(delay, current, ticket)) {
#  if !defined(NDEBUG)
                thread_id_.store(threadIdx.x, memory_order_relaxed);
                block_id_.store(blockIdx.x, memory_order_release);
#  endif
                detail::apply(tuple, fn);
                current_.fetch_add(1, memory_order_release);
            }
        } while (current != ticket);
    });
    g.sync();
}

template<thread_scope _Sco>
template<typename _Cg, typename _Fn, typename... Args>
__device__ inline auto spinlock<_Sco>::critical_section(const _Cg & g, _Fn && fn, Args &&... args) noexcept
    -> decltype(fn(std::forward<Args>(args)...)) {
    return __device_critical_section(g, std::forward<_Fn>(fn), std::forward<Args>(args)...);
}

template<thread_scope _Sco>
template<typename _Cg, typename _Fn, typename... Args>
__device__ inline auto spinlock<_Sco>::parallel_critical_section(const _Cg & g, _Fn && fn, Args &&... args) noexcept
    -> decltype(fn(std::forward<Args>(args)...)) {
    return __device_parallel_critical_section(g, std::forward<_Fn>(fn), std::forward<Args>(args)...);
}

template<thread_scope _Sco>
template<typename _Cg, typename _Fn, typename... Args>
__device__ inline auto spinlock<_Sco>::single_thread_critical_section(
    const _Cg & g, _Fn && fn, Args &&... args) noexcept -> decltype(fn(std::forward<Args>(args)...)) {
    return __device_single_thread_critical_section(g, std::forward<_Fn>(fn), std::forward<Args>(args)...);
}

template<thread_scope _Sco>
template<typename _Cg>
__device__ inline void spinlock<_Sco>::lock(const _Cg & g) noexcept {
    unsigned id, ticket;

    id = g.thread_rank();
    ticket = cooperative_groups::invoke_one_broadcast(g, [this, &g] { return ticket_.fetch_add(g.num_threads()); });
    ticket += id;
    busy_wait(ticket);

#  if !defined(NDEBUG)
    thread_id_.store(threadIdx.x, memory_order_relaxed);
    block_id_.store(blockIdx.x, memory_order_release);
#  endif
}

template<thread_scope _Sco>
template<typename _Cg>
__device__ inline void spinlock<_Sco>::parallel_lock(const _Cg & g) noexcept {
    cooperative_groups::invoke_one(g, [this, &g] {
        unsigned ticket = ticket_.fetch_add(g.num_threads(), memory_order_acquire);
        busy_wait(ticket);
#  if !defined(NDEBUG)
        thread_id_.store(threadIdx.x, memory_order_relaxed);
        block_id_.store(blockIdx.x, memory_order_release);
#  endif
    });
}

template<thread_scope _Sco>
template<typename _Cg>
__device__ inline void spinlock<_Sco>::unlock(const _Cg & g) noexcept {
    cooperative_groups::invoke_one(g, [this, &g] { current_.fetch_add(g.num_threads(), memory_order_release); });
}

