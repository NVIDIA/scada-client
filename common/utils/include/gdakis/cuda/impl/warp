__device__ inline unsigned this_warp::ballot(unsigned active_mask, bool value) noexcept {
#  if defined(GDAKIS_SW4166479)
    unsigned mask;
    unsigned __value = value ? 1 : 0;
    asm("{.reg .pred %%p; setp.eq.b32 %%p, %1, 1; .pragma \"sw4166479\"; vote.sync.ballot.b32 %0, %%p, %2; }"
        : "=r"(mask)
        : "r"(__value), "r"(active_mask));
#  else
    unsigned mask = __ballot_sync(active_mask, value);
#  endif
    return mask;
}

namespace detail {

template<typename T, T(Op)(const T &, const T &)>
__device__ static inline T __reduce_full_warp(const T & value) noexcept {
    T ret = value;
    for (int i = this_warp::size >> 1; i > 0; i >>= 1) {
        T tmp = this_warp::shuffle_xor(-1U, ret, i);
        ret = Op(tmp, ret);
    }
    return ret;
}

template<typename T, T(Op)(const T &, const T &)>
__device__ static inline T __reduce_partial_warp(unsigned active_mask, const T & value) noexcept {
    unsigned loop_mask = active_mask;
    unsigned id = popc(active_mask & lanemask_lt());
    unsigned n = 1;
    T ret = value;

    while (popc(loop_mask) > 1) {
        T tmp;
        int peer;

        if (id & n) {
            int pivot = bfind(loop_mask & lanemask_le());
            peer = bfind(loop_mask & ((1 << pivot) - 1));
        } else {
            peer = ffs(loop_mask & lanemask_gt()) - 1;
        }
        peer = peer >= 0 ? peer : laneid();

        tmp = __shuffle(active_mask, ret, peer);
        if (peer != laneid())
            ret = Op(ret, tmp);
        loop_mask = loop_mask & __ballot_sync(active_mask, (id & n) == 0);
        n <<= 1;
    }
    ret = __shuffle(active_mask, ret, ffs(active_mask) - 1);
    return ret;
}

}

template<typename _Tp, _Tp(Op)(const _Tp &, const _Tp &)>
__device__ inline _Tp this_warp::reduce(unsigned active_mask, const _Tp & value) noexcept {
    if (active_mask == -1U)
        return detail::__reduce_full_warp<_Tp, Op>(value);
    return detail::__reduce_partial_warp<_Tp, Op>(active_mask, value);
}

namespace detail {

template<typename T, T(Op)(const T &, const T &)>
__device__ static inline T __scan_full_warp(const T & value) {
    T ret = value;
    for (int i = 1; i <= warpSize; i >>= 1) {
        T tmp = __shuffle_up(-1U, ret, i);
        if (laneid() >= i)
            ret = Op(tmp, ret);
    }
    return ret;
}

template<typename T, T(Op)(const T &, const T &)>
__device__ static inline T __scan_partial_warp(unsigned active_mask, const T & value) {
    unsigned loop_mask = active_mask;
    unsigned id = popc(active_mask & lanemask_lt());
    unsigned total = popc(active_mask);
    unsigned n = 1;
    T ret = value;

    while (popc(loop_mask) > 1) {
        T tmp;
        int peer;

        peer = ffs(active_mask & lanemask_gt()) - 1;
        peer = peer > 0 ? peer : laneid();
        tmp = __shuffle(active_mask, value, peer);

        if (total - id > n)
            ret = Op(ret, tmp);

        unsigned step_mask = __ballot_sync(loop_mask, (id & n) == 0);
        loop_mask = (id & n) == 0 ? loop_mask & step_mask : loop_mask & ~step_mask;
        n <<= 1;
    }
    return ret;
}

}

template<typename _Tp, _Tp(Op)(const _Tp &, const _Tp &)>
__device__ static inline _Tp scan(unsigned active_mask, const _Tp & value) {
    if (active_mask == -1U)
        return detail::__scan_full_warp<_Tp, Op>(value);
    return detail::__scan_partial_warp<_Tp, Op>(active_mask, value);
}

template<typename T>
__device__ inline T op::max(const T & a, const T & b) noexcept {
    return a >= b ? a : b;
}

template<typename T>
__device__ inline T op::min(const T & a, const T & b) noexcept {
    return a < b ? a : b;
}

template<typename T>
__device__ inline T op::add(const T & a, const T & b) noexcept {
    return a + b;
}

template<typename T>
__device__ inline T op::or_(const T & a, const T & b) noexcept {
    return a | b;
}

template<typename T>
__device__ inline T op::and_(const T & a, const T & b) noexcept {
    return a & b;
}

