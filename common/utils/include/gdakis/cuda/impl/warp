#if defined(__CUDACC__)

__device__ inline void this_warp::sync(unsigned mask) noexcept {
    __syncwarp(mask);
}

__device__ inline unsigned this_warp::leader(unsigned mask) noexcept {
    return ffs(mask) - 1;
}

namespace detail {
template<typename _Fn, typename... Args>
__device__ static inline typename std::enable_if<std::is_void_v<std::invoke_result_t<_Fn, Args...>>>::type
__single_thread(const unsigned & active_mask, _Fn && fn, Args &&... args) {
    if (active_mask == lanemask_eq()) {
        fn(std::forward<Args>(args)...);
    } else {
        if (this_thread::is_leader(active_mask))
            fn(std::forward<Args>(args)...);
        this_warp::sync(active_mask);
    }
}

template<typename _Fn, typename... Args>
__device__ static inline typename std::enable_if<!std::is_void_v<std::invoke_result_t<_Fn, Args...>>,
    std::invoke_result_t<_Fn, Args...>>::type
__single_thread(const unsigned & active_mask, _Fn && fn, Args &&... args) {
    if (active_mask == lanemask_eq()) {
        return fn(std::forward<Args>(args)...);
    } else {
        using return_type = std::invoke_result_t<_Fn, Args...>;
        unsigned char buffer[sizeof(return_type)];
        return_type * ret = reinterpret_cast<return_type *>(buffer);

        if (this_thread::is_leader(active_mask)) {
            return_type tmp(fn(std::forward<Args>(args)...));
            memcpy(ret, &tmp, sizeof(tmp));
        }
        return this_warp::shuffle(active_mask, *ret, this_warp::leader(active_mask));
    }
}

}

template<typename _Fn, typename... Args>
__device__ inline std::invoke_result_t<_Fn, Args...> this_warp::single_thread(
    unsigned mask, _Fn && fn, Args &&... args) noexcept {
    return detail::__single_thread(mask, std::forward<_Fn>(fn), std::forward<Args>(args)...);
}

namespace detail {

template<typename _Tp>
__device__ static inline typename std::enable_if<sizeof(_Tp) == 4, _Tp>::type __shuffle(
    unsigned active_mask, const _Tp & value, int leader) noexcept {
#  if defined(GDAKIS_SW4166479)
    unsigned ret;
    asm(".pragma \"sw4166479\"; shfl.sync.idx.b32 %0, %1, %2, 0x1f, %3;"
        : "=r"(ret)
        : "r"(*reinterpret_cast<const unsigned *>(&value)), "r"(leader), "r"(active_mask));
#  else
    unsigned ret = __shfl_sync(active_mask, *(reinterpret_cast<const unsigned *>(&value)), leader);
#  endif
    return *(reinterpret_cast<_Tp *>(&ret));
}

template<typename _Tp>
__device__ static inline typename std::enable_if<sizeof(_Tp) == 8, _Tp>::type __shuffle(
    unsigned active_mask, const _Tp & value, int leader) noexcept {
#  if defined(GDAKIS_SW4166479)
    unsigned high, low;
    asm(".pragma \"sw4166479\"; shfl.sync.idx.b32 %0, %1, %2, 0x1f, %3;"
        : "=r"(low)
        : "r"(*reinterpret_cast<const unsigned *>(&value)), "r"(leader), "r"(active_mask));
    asm(".pragma \"sw4166479\"; shfl.sync.idx.b32 %0, %1, %2, 0x1f, %3;"
        : "=r"(high)
        : "r"(*(reinterpret_cast<const unsigned *>(&value) + 1)), "r"(leader), "r"(active_mask));
    unsigned long long ret = high;
    ret = (ret << 32) | low;
#  else

    unsigned long long ret = __shfl_sync(active_mask, *(reinterpret_cast<const unsigned long long *>(&value)), leader);
#  endif
    return *(reinterpret_cast<_Tp *>(&ret));
}

template<size_t N>
__device__ static inline void __shuffle_copy(
    unsigned active_mask, unsigned long * dst, const unsigned long * src, int leader) noexcept {
    *dst = __shuffle(active_mask, *src, leader);
    __shuffle_copy<N - 4>(active_mask, ++dst, ++src, leader);
}

template<>
__device__ inline void __shuffle_copy<4>(
    unsigned active_mask, unsigned long * dst, const unsigned long * src, int leader) noexcept {
    *dst = __shuffle(active_mask, *src, leader);
}

template<>
__device__ inline void __shuffle_copy<3>(
    unsigned active_mask, unsigned long * dst, const unsigned long * src, int leader) noexcept {
    unsigned ret = __shuffle(active_mask, *src, leader);
    ::memcpy(&dst, &ret, 3);
}

template<>
__device__ inline void __shuffle_copy<2>(
    unsigned active_mask, unsigned long * dst, const unsigned long * src, int leader) noexcept {
    unsigned ret = __shuffle(active_mask, *src, leader);
    ::memcpy(&dst, &ret, 2);
}

template<>
__device__ inline void __shuffle_copy<1>(
    unsigned active_mask, unsigned long * dst, const unsigned long * src, int leader) noexcept {
    unsigned ret = __shuffle(active_mask, *src, leader);
    ::memcpy(&dst, &ret, 1);
}

template<typename T>
__device__ static inline typename std::enable_if<(sizeof(T) > 8), T>::type __shuffle(
    unsigned active_mask, const T & value, int leader) noexcept {
    unsigned char buffer[sizeof(T)];
    T * ret = reinterpret_cast<T *>(buffer);
    __shuffle_copy<sizeof(T)>(active_mask, reinterpret_cast<unsigned long *>(buffer),
        reinterpret_cast<const unsigned long *>(&value), leader);
    return std::move(*ret);
}

__device__ static inline bool __shuffle(unsigned active_mask, bool value, int leader) noexcept {
#  if defined(GDAKIS_SW4166479)
    unsigned mask;
    unsigned __value = value ? 1 : 0;
    asm("{.reg .pred %%p; setp.eq.b32 %%p, %1, 1; .pragma \"sw4166479\"; vote.sync.ballot.b32 %0, %%p, %2; }"
        : "=r"(mask)
        : "r"(__value), "r"(active_mask));
#  else
    unsigned mask = __ballot_sync(active_mask, value);
#  endif
    return mask & (1UL << leader);
}

}

template<typename _Tp>
__device__ inline _Tp this_warp::shuffle(unsigned mask, const _Tp & value, int id) noexcept {
    return detail::__shuffle(mask, value, id);
}

