@startuml
title Autobatch v3 Group Push Operation

participant "Thread Group" as TG
participant "Autobatch" as AB
participant "Buffer" as BUF
participant "Storage" as S

note over TG, S: Cooperative Groups path

TG -> AB: push(group, work_request)
activate AB

AB -> AB: enter_group(group)
activate AB #DarkGray

AB -> AB: Single thread gets current_buffer_
AB -> AB: Broadcast buffer_idx to group
AB -> BUF: try_enter_group(group)
activate BUF

BUF -> BUF: Single thread atomically increments in_ counter by group.size()
BUF -> BUF: Broadcast in_ value to group
BUF -> BUF: Check if commit bit set (bit 63)

alt commit bit set
    BUF --> AB: return false
    AB -> AB: Try next buffer
else commit bit not set
    BUF -> BUF: Each thread calculates its position = base + thread_rank
    BUF -> BUF: Extract epoch (bits 60-62)
    alt all positions < buffer size
        BUF --> AB: return true with positions & epoch
    else any position >= buffer size
        BUF --> AB: return false
        AB -> AB: Try next buffer
    end
end
deactivate BUF

AB --> AB: return entry token (buffer_idx, positions, epoch)
deactivate AB

AB -> BUF: Each thread: set(position, work_request)
activate BUF
BUF -> S: Store work requests at positions
BUF --> AB: done
deactivate BUF

AB -> TG: group.sync()

AB -> AB: exit_group(group, token)
activate AB #DarkGray
AB -> BUF: exit_group(group, epoch)
activate BUF

BUF -> BUF: Single thread atomically increments out_ counter by group.size()
BUF -> BUF: Check current epoch matches token epoch

alt epochs don't match
    BUF --> AB: Buffer already committed, skip commitment
else epochs match
    BUF -> BUF: Check commitment conditions

    alt buffer is full OR all entries validated
        BUF -> BUF: Set commit bit in in_ counter (bit 63)
        BUF -> BUF: process_and_reset_buffer()
        activate BUF #DarkSalmon
        
        BUF -> S: commit(count)
        activate S
        S --> BUF: done
        deactivate S
        
        BUF -> S: acquire()
        activate S
        S --> BUF: done
        deactivate S
        
        BUF -> BUF: reset(epoch + 1)
        BUF --> BUF: done
        deactivate BUF
    end
end

BUF --> AB: done
deactivate BUF

AB --> AB: done
deactivate AB

AB --> TG: done
deactivate AB

@enduml 