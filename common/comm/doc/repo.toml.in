[repo]
logging = "warn"


[repo_docs]
enabled = true
project = "gdakis-comm"
name = "GDAKIS Communication"
version = "@PROJECT_VERSION@"
copyright_start = 2022

docs_root = "docs"
logo = "images/NVIDIA_logo.png"

sphinx_conf_py_extra = """
    numfig = True
"""

doxygen_input = [
    "@CMAKE_SOURCE_DIR@/include/gdakis/*",
    "@CMAKE_SOURCE_DIR@/include/gdakis/__comm_log",
    "@CMAKE_SOURCE_DIR@/include/gdakis/autobatch",
    "@CMAKE_SOURCE_DIR@/include/gdakis/none",
    "@CMAKE_SOURCE_DIR@/include/gdakis/protocol",
    "@CMAKE_SOURCE_DIR@/include/gdakis/ipc/autobatch",
    "@CMAKE_SOURCE_DIR@/include/gdakis/ipc/io_buffer_pool",
    "@CMAKE_SOURCE_DIR@/include/gdakis/ipc/memory_buffer",
    "@CMAKE_SOURCE_DIR@/include/gdakis/ipc/protocol",
    "@CMAKE_SOURCE_DIR@/include/gdakis/ipc/frame_traits",
    "@CMAKE_SOURCE_DIR@/include/gdakis/ipc/impl/cpu/shmem",
    "@CMAKE_SOURCE_DIR@/include/gdakis/ipc/impl/cuda/shmem"
]
doxygen_dst = "@PROJECT_BINARY_DIR@/tmp"
doxygen_strip_from_path = [
    "@PROJECT_SOURCE_DIR@/include"
]
doxygen_conf_extra = """
   SEARCH_INCLUDES = YES
   EXTENSION_MAPPING = "no_extension=C++"
   INCLUDE_PATH = @CMAKE_SOURCE_DIR@/include
   PREDEFINED = __DOXYGEN__
"""

api_title = "GDAKIS Utils"
api_output_directory = "docs/_build/api"
api_item_filters = [
    { rule = "exclude", attribute = "protection",   matching = "protected"},
    { rule = "exclude", attribute = "kind",         matching = "file"},
    { rule = "exclude", attribute = "kind",         matching = "dir"},
    { rule = "exclude", attribute = "kind",         matching = "define"},
]
api_root_page = {}
api_toc_pages = [
   {docname = "namespaces", title = "Namespace", kinds = ["namespace"]},
   {docname = "classes", title = "Class List", kinds = ["class"]},
]
