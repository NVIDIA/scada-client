inline void checkCudaResult(CUresult result, const char * func, const char * file, int line) {
    if (result != CUDA_SUCCESS) {
        const char * errorName;
        const char * errorDescription;
        cuGetErrorName(result, &errorName);
        cuGetErrorString(result, &errorDescription);
        COMM_LOG("CUDA error in function: ", func, " at file: ", file, " line: ", line, " Error: ", errorName,
            " Description: ", errorDescription);
    }
}

inline void checkCudaError(cudaError_t error, const char * func, const char * file, int line) {
    if (error != cudaSuccess) {
        const char * errorName;
        const char * errorDescription;
        cuGetErrorName(static_cast<CUresult>(error), &errorName);
        cuGetErrorString(static_cast<CUresult>(error), &errorDescription);
        COMM_LOG("CUDA error in function: ", func, " at file: ", file, " line: ", line, " Error: ", errorName,
            " Description: ", errorDescription);
    }
}

// Macro to wrap CUDA calls for error checking
#  define CHECK_CUDA_RESULT(val) checkCudaResult((val), #val, __FILE__, __LINE__)
#  define CHECK_CUDA_ERROR(error) checkCudaError((error), #error, __FILE__, __LINE__)

namespace {

inline psa::result<int, int> require_cuda_ipc_device(const char * operation_name) noexcept {
    auto ready = gdakis::cuda::ensure_runtime_context_current();
    if (ready.is_err()) {
        COMM_LOG(operation_name, " failed to prepare CUDA runtime/context (err = ", ready.err(), ")");
    }
    return ready;
}

