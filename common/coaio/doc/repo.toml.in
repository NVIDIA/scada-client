[repo]
logging = "warn"


[repo_docs]
enabled = true
project = "psa-coaio"
name = "C++ Coroutine Asynchronous I/O"
version = "@PROJECT_VERSION@"
copyright_start = 2022

docs_root = "docs"
logo = "images/NVIDIA_logo.png"

doxygen_input = [
    "@CMAKE_SOURCE_DIR@/include/psa/coaio/socket",
    "@CMAKE_SOURCE_DIR@/include/psa/coaio/v1/socket"
]
doxygen_dst = "@PROJECT_BINARY_DIR@/tmp"
doxygen_strip_from_path = [
    "@PROJECT_SOURCE_DIR@/include"
]
doxygen_conf_extra = """
   SEARCH_INCLUDES = YES
   EXTENSION_MAPPING = "no_extension=C++"
   INCLUDE_PATH = @CMAKE_SOURCE_DIR@/include
"""

api_title = "C++ Coroutine Asynchronous I/O"
api_output_directory = "docs/_build/api"
api_item_filters = [
    { rule = "exclude", attribute = "protection",   matching = "protected"},
    { rule = "exclude", attribute = "kind",         matching = "file"},
    { rule = "exclude", attribute = "kind",         matching = "dir"},
    { rule = "exclude", attribute = "kind",         matching = "define"},
]
api_root_page = {}
api_toc_pages = [
   {docname = "namespaces", title = "Namespace", kinds = ["namespace"]},
   {docname = "classes", title = "Class List", kinds = ["class"]},
]