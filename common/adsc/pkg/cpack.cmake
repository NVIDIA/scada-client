message(STATUS "Setting CPack for ${PROJECT_NAME}")
set(CPACK_PACKAGE_NAME
    ${PROJECT_NAME}
    CACHE STRING "Package name"
)
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY
    "C++ Asynchronous I/O"
    CACHE STRING "C++ header-only library that provides a co-routine based asynchronous I/O API"
)
set(CPACK_PACKAGE_VENDOR "NVIDIA")
set(CPACK_VERBATIM_VARIABLES YES)
set(CPACK_PACKAGE_INSTALL_DIRECTORY ${CPACK_PACKAGE_NAME})
set(CPACK_OUTPUT_FILE_PREFIX packages)
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
set(CPACK_PACKAGE_VERSION_MAJOR ${PROJECT_VERSION_MAJOR})
set(CPACK_PACKAGE_VERSION_MINOR ${PROJECT_VERSION_MINOR})
set(CPACK_PACKAGE_VERSION_PATCH ${PROJECT_VERSION_PATCH})
set(CPACK_PACKAGE_CONTACT "zqureshi@nvidia.com")
set(CPACK_DEBIAN_PACKAGE_MAINTAINER "Zaid Qureshi")
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
#set(CPACK_COMPONENTS_GROUPING ALL_COMPONENTS_IN_ONE)
set(CPACK_DEB_COMPONENT_INSTALL YES)
include(CPack)
