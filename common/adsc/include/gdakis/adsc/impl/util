#ifndef GDAKIS_ADSC_IMPL_UTIL
#define GDAKIS_ADSC_IMPL_UTIL

#include <gdakis/bits>
#include <gdakis/cuda/regs>
#include <gdakis/cuda/warp>

GDAKIS_ADSC_SIMPLE_NS {
GDAKIS_ADSC_UNIT(util) {

template<typename _Fn, typename _Group>
__host__ __device__ inline auto single_thread(const _Group & group, _Fn && fn) {
#if defined(__CUDA_ARCH__)
    cooperative_groups::invoke_one(group, std::forward<_Fn>(fn));
    group.sync();
    return;
#else
    return fn();
#endif
}

template<typename _Fn, typename _Group>
__host__ __device__ inline auto single_thread_broadcast(const _Group & group, _Fn && fn) {
#if defined(__CUDA_ARCH__)
    auto ret = cooperative_groups::invoke_one_broadcast(group, std::forward<_Fn>(fn));
    group.sync();
    return ret;
#else
    return fn();
#endif
}

__host__ __device__ static inline bool is_aligned(const void * pointer, size_t byte_count) {
    return (uintptr_t)pointer % byte_count == 0;
}

#if defined(__CUDACC__)
template<typename _Tp, typename _Group>
__device__ inline void group_memcpy(const _Group & active_group, _Tp * dst_, const _Tp * src_, const size_t bytes) {
    unsigned effective_group_size = active_group.size();
    unsigned effective_lane_id = active_group.thread_rank();

    size_t left_bytes;

#  if defined(__CUDACC__)

    if (is_aligned(dst_, 128) and is_aligned(src_, 128) and (bytes >= sizeof(ulonglong4))) {
        ulonglong4 * dst = reinterpret_cast<ulonglong4 *>(dst_);
        const ulonglong4 * src = reinterpret_cast<const ulonglong4 *>(src_);
        for (size_t i = effective_lane_id; (i * sizeof(ulonglong4)) < bytes; i += effective_group_size)
            dst[i] = src[i];

        left_bytes = bytes % sizeof(ulonglong4);

    } else if (is_aligned(dst_, 8) and is_aligned(src_, 8) and (bytes >= sizeof(uint64_t))) {
#  else
    if (is_aligned(dst_, 8) and is_aligned(src_, 8) and (bytes >= sizeof(uint64_t))) {
#  endif
        uint64_t * dst = reinterpret_cast<uint64_t *>(dst_);
        const uint64_t * src = reinterpret_cast<const uint64_t *>(src_);
        for (size_t i = effective_lane_id; (i * sizeof(uint64_t)) < bytes; i += effective_group_size)
            dst[i] = src[i];

        left_bytes = bytes % sizeof(uint64_t);
    } else if (is_aligned(dst_, 4) and is_aligned(src_, 4) and (bytes >= sizeof(uint32_t))) {
        uint32_t * dst = reinterpret_cast<uint32_t *>(dst_);
        const uint32_t * src = reinterpret_cast<const uint32_t *>(src_);
        for (size_t i = effective_lane_id; (i * sizeof(uint32_t)) < bytes; i += effective_group_size)
            dst[i] = src[i];

        left_bytes = bytes % sizeof(uint32_t);
    } else {
        uint8_t * dst = reinterpret_cast<uint8_t *>(dst_);
        const uint8_t * src = reinterpret_cast<const uint8_t *>(src_);
        for (size_t i = effective_lane_id; i < bytes; i += effective_group_size)
            dst[i] = src[i];

        left_bytes = 0;
    }
    active_group.sync();

    size_t offset = bytes - left_bytes;
    uint8_t * dst = reinterpret_cast<uint8_t *>(dst_) + offset;
    const uint8_t * src = reinterpret_cast<const uint8_t *>(src_) + offset;

    for (size_t i = effective_lane_id; i < left_bytes; i += effective_group_size)
        dst[i] = src[i];
}
#endif

}}
#endif
