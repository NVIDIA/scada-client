__host__ __device__ inline int cache<_Sco, _CL_Ref, _Ways>::get(const key_type & key, val_type & val) noexcept {
    return get(key, val, default_policies_);
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
__host__ __device__ inline int cache<_Sco, _CL_Ref, _Ways>::put(const key_type & key, const val_type & val) noexcept {
    return put(key, val, default_policies_);
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Policies>
__host__ __device__ inline int cache<_Sco, _CL_Ref, _Ways>::put(
    const key_type & key, const val_type & val_, const _Policies & policies) noexcept {
#if defined(__CUDA_ARCH__)
    auto active_group = cooperative_groups::coalesced_threads();
#else
    unsigned active_group = 1;
#endif
    auto cl_id_ = cl_id(key, policies);
    auto cl_offset_ = cl_offset(key, policies);
    auto set_id_ = set_id(cl_id_, policies);

#if defined(__CUDA_ARCH__)
    auto cl_group = cooperative_groups::labeled_partition(active_group, static_cast<std::uint64_t>(cl_id_));
#else
    unsigned cl_group = active_group;
#endif

    unsigned way = _Ways;

    auto ret = miss_prologue(
        cl_group, cl_id_, cl_offset_, val_, way, policies,
        [this](auto & group, const set_id_type set_id, const _Policies & policies) {
            return single_thread_broadcast(
                group, [this, set_id, &policies] { return this->evict_thread(set_id, policies); });
        },
        [this](auto & group, const set_id_type & set_id, const unsigned way, const cl_id_type & cl_id,
            const _Policies & policies) {
            return single_thread_broadcast(group, [this, &set_id, way, &cl_id, &policies] {
                auto ret = this->victim_thread(set_id, way, policies);
                this->cl_id(set_id, way) = cl_id;
                return ret;
            });
        },
        [this](auto & group, const set_id_type & set_id, const unsigned way, const cl_id_type & cl_id,
            const _Policies & policies) {
            return single_thread_broadcast(group, [this, &set_id, way, &policies] {
                // cl_size counts values: a single-value line is completely overwritten by put.
                if constexpr (cl_size == 1) {
                    return 0;
                }
                int ret = this->miss_thread(set_id, way, policies);
                if (ret < 0)
                    this->cl_id(set_id, way) = invalid_cl_id;
                return ret;
            });
        });

    if (ret == 0) {
        ::memcpy(reinterpret_cast<void *>(val(set_id_, way, cl_offset_)), &val_, sizeof(val_type));
        cl_ref(set_id_, way).mark_dirty();
    }

    miss_epilogue(cl_group, cl_id_, set_id_, way);

    return ret;
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Policies>
__host__ __device__ inline int cache<_Sco, _CL_Ref, _Ways>::__victim_thread(unsigned & group,
    const set_id_type & set_id, const unsigned way, const cl_id_type & cl_id, const _Policies & policies) noexcept {
    return single_thread_broadcast(group, [this, &set_id, way, &cl_id, &policies] {
        auto ret = this->victim_thread(set_id, way, policies);
        this->cl_id(set_id, way) = cl_id;
        return ret;
    });
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Policies>
__host__ __device__ inline int cache<_Sco, _CL_Ref, _Ways>::__miss_thread(unsigned & group, const set_id_type & set_id,
    const unsigned way, const cl_id_type & cl_id, const _Policies & policies) noexcept {
    return single_thread_broadcast(group, [this, &set_id, way, &cl_id, &policies] {
        int ret = this->miss_thread(set_id, way, policies);
        if (ret < 0)
            this->cl_id(set_id, way) = invalid_cl_id;
        return ret;
    });
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Policies>
__host__ __device__ inline unsigned cache<_Sco, _CL_Ref, _Ways>::__evict_thread(
    unsigned & group, const set_id_type set_id, const _Policies & policies) noexcept {
    return single_thread(group, [this, set_id, &policies] { this->evict_thread(set_id, policies); });
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Group, typename _Policies, typename _Evict_Processing, typename _Victim_Processing,
    typename _Fill_Processing>
__host__ __device__ inline int cache<_Sco, _CL_Ref, _Ways>::miss_prologue(const _Group & group,
    const cl_id_type & cl_id, const unsigned cl_offset, const val_type & val, unsigned & way,
    const _Policies & policies, _Evict_Processing && evict_process, _Victim_Processing && victim_process,
    _Fill_Processing && fill_process) noexcept {
    int ret = 0;
    auto set_id_ = set_id(cl_id, policies);
    single_thread(group, [this, set_id_] { this->set_seqlock(set_id_).write_lock(); });

    way = search_ways_group(group, cl_id, set_id_);

    if (way == _Ways) {
        way = evict_process(group, set_id_, policies);
    }

    cl_id_type way_cl_id = single_thread_broadcast(group, [this, set_id_, way] {
        this->cl_seqlock(set_id_, way).write_lock();
        return this->cl_id(set_id_, way);
    });

    bool is_match = cl_id == way_cl_id;

    if (!is_match) {
        ret = victim_process(group, set_id_, way, cl_id, policies);
        single_thread(group, [this, set_id_, way] { this->cl_ref(set_id_, way).reset(); });
    }

    single_thread(group, [this, set_id_] { this->set_seqlock(set_id_).write_unlock(); });

    if (!is_match) {
        single_thread(group, [this, set_id_, way, cl_id] { this->cl_ref(set_id_, way).cl_id() = cl_id; });
        ret |= fill_process(group, set_id_, way, cl_id, policies);
    }

    return ret;
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Group>
__host__ __device__ inline void cache<_Sco, _CL_Ref, _Ways>::miss_epilogue(
    const _Group & group, const cl_id_type & cl_id, const set_id_type set_id_, const unsigned way) noexcept {
    single_thread(group, [this, set_id_, way] { this->cl_seqlock(set_id_, way).write_unlock(); });
}

// Async cache line acquisition methods
template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Group, typename _Policies>
__host__ __device__ inline int cache<_Sco, _CL_Ref, _Ways>::async_hit_prologue(const _Group & group,
    const cl_id_type & cl_id, set_id_type & set_id_, unsigned & way, const _Policies & policies) noexcept {
    int ret = 0;
    // Enforce that each thread uses its own single-thread group to avoid divergence deadlocks
    assert(group.size() == 1
        && "async_hit_prologue must be called with single-thread group when threads have different cl_ids");

    // Compute set_id for this cache line
    set_id_ = set_id(cl_id, policies);

    // Lock set seqlock
    single_thread(group, [this, set_id_] { this->set_seqlock(set_id_).write_lock(); });

    // Search for cache line
    way = search_ways_group(group, cl_id, set_id_);

    if (way < _Ways) {
        // Found it - lock the cache line
        single_thread(group, [this, set_id_, way] { this->cl_seqlock(set_id_, way).write_lock(); });

        // Verify it's still a hit
        auto way_cl_id = single_thread_broadcast(group, [this, set_id_, way] { return this->cl_id(set_id_, way); });

        bool is_match = (cl_id == way_cl_id);

        // Unlock set
        single_thread(group, [this, set_id_] { this->set_seqlock(set_id_).write_unlock(); });

        if (is_match) {
            // Cache hit! Return with CL lock held
            ret = 0;
        } else {
            // False hit - unlock CL
            single_thread(group, [this, set_id_, way] { this->cl_seqlock(set_id_, way).write_unlock(); });
            ret = -ENOENT;
        }
    } else {
        // Way not found - unlock set
        single_thread(group, [this, set_id_] { this->set_seqlock(set_id_).write_unlock(); });

        ret = -ENOENT;
    }
    return ret;
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Group, typename _Policies, typename _Evict_Processing, typename _Victim_Processing>
__host__ __device__ inline int cache<_Sco, _CL_Ref, _Ways>::async_miss_prologue(const _Group & group,
    const cl_id_type & cl_id, set_id_type & set_id_, unsigned & way, const _Policies & policies,
    _Evict_Processing && evict_process, _Victim_Processing && victim_process) noexcept {
    // Enforce that each thread uses its own single-thread group to avoid divergence deadlocks
    assert(group.size() == 1
        && "async_miss_prologue must be called with single-thread group when threads have different cl_ids");

    // Compute set_id
    set_id_ = set_id(cl_id, policies);

    // Lock set
    single_thread(group, [this, set_id_] { this->set_seqlock(set_id_).write_lock(); });

    // Search for way
    way = search_ways_group(group, cl_id, set_id_);

    // If way not found, evict
    if (way == _Ways) {
        way = evict_process(group, set_id_, policies);
    }

    // Lock cache line
    auto way_cl_id = single_thread_broadcast(group, [this, set_id_, way] {
        this->cl_seqlock(set_id_, way).write_lock();
        return this->cl_id(set_id_, way);
    });

    bool is_match = (cl_id == way_cl_id);

    // Handle victim if needed
    if (!is_match) {
        int ret = victim_process(group, set_id_, way, cl_id, policies);

        if (ret != 0) {
            // Victim handling failed - unlock and return error
            single_thread(group, [this, set_id_, way] { this->cl_seqlock(set_id_, way).write_unlock(); });
            single_thread(group, [this, set_id_] { this->set_seqlock(set_id_).write_unlock(); });
            return ret;
        }

        // Reset cache line reference as victim handling is successful
        single_thread(group, [this, set_id_, way] { this->cl_ref(set_id_, way).reset(); });
        single_thread(group, [this, set_id_, way, cl_id] { this->cl_ref(set_id_, way).cl_id() = cl_id; });
    }

    // Unlock set
    single_thread(group, [this, set_id_] { this->set_seqlock(set_id_).write_unlock(); });

    // Return with CL lock held
    return 0;
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Group>
__host__ __device__ inline void cache<_Sco, _CL_Ref, _Ways>::async_epilogue(
    const _Group & group, const set_id_type set_id_, const unsigned way) noexcept {
    single_thread(group, [this, set_id_, way] { this->cl_seqlock(set_id_, way).write_unlock(); });
}

