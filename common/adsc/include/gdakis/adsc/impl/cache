template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Allocator>
inline void cache<_Sco, _CL_Ref, _Ways>::handle<_Allocator>::invalidate_cache() const noexcept {
    if constexpr (!std::is_same_v<_Allocator, umem::cpu>) {
#if defined(__CUDACC__)
        auto cache_ptr = cache_.get();
        _Allocator::call_map(cl_refs_.get(), num_cls_,
            [cache_ptr] __device__(std::size_t id, cl_ref_type * ref) { invalidate_fn(cache_ptr, id, ref); });
        auto ret = cudaStreamSynchronize(_Allocator::get_stream());
        printf("cudaStreamSynchronize ret: %d\n", ret);
#endif
        // #else any other _Allocator type is UNSUPPORTED.
        // this needs to be supported when a new device type
        // like DPU is brought into the picture
    } else {
        _Allocator::call_map(cl_refs_.get(), num_cls_,
            [cache = cache_.get()](std::size_t id, cl_ref_type * ref) { cache->invalidate_cl(ref[0]); });
    }
}

#if defined(__CUDACC__) or defined(__DOXYGEN__)

template<typename _Cache, typename _Policies>
__global__ void flush_kernel(_Cache * cache, _Policies policies) {
    auto tid = threadIdx.x + blockDim.x * blockIdx.x;
    if (tid < cache->num_cls()) {
        auto way = tid % cache->num_ways;
        auto set = tid / cache->num_ways;
        cache->flush_cl(cache->cl_ref(set, way), policies);
    }
}

#endif

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Allocator>
template<typename _Policies>
inline void cache<_Sco, _CL_Ref, _Ways>::handle<_Allocator>::flush_cache(const _Policies & policies_) const noexcept {
    if constexpr (std::is_same_v<_Allocator, umem::cpu>) {
        _Allocator::call_map(
            cl_refs_.get(), num_cls_, [cache = cache_.get(), policies = policies_](std::size_t id, cl_ref_type * ref) {
                cache->flush_cl(ref[0], policies);
            });
    } else {
#if defined(__CUDACC__) or defined(__DOXYGEN__)
        const auto blk_size = 128;
        const auto n_blks = (num_cls_ + blk_size - 1) / blk_size;
        flush_kernel<<<n_blks, blk_size, 0, _Allocator::get_stream()>>>(cache_.get(), policies_);
        auto ret = cudaStreamSynchronize(_Allocator::get_stream());
#endif
    }
}

