#if defined(__CUDACC__)
template<typename _Cache, typename _CL_Ref>
__device__ static void invalidate_fn(_Cache * cache, std::size_t id, _CL_Ref * ref) {
    cache->invalidate_cl(ref[0]);
}
#endif

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Allocator>
inline typename cache<_Sco, _CL_Ref, _Ways>::template handle<_Allocator> cache<_Sco, _CL_Ref, _Ways>::build(
    std::size_t num_cls, typename _CL_Ref::val_type * data_ptr) noexcept {
    auto cl_ids = umem::mem<_Allocator, cl_id_type[]>::alloc(
        num_cls, [] __host__ __device__(std::size_t id, cl_id_type * cl_id) { *cl_id = cache::invalid_cl_id; });
    auto set_seqlocks = umem::mem<_Allocator, seqlock[]>::alloc(
        num_cls / _Ways, [] __host__ __device__(std::size_t id, seqlock * seqlock) { seqlock->init(); });
    auto cl_seqlocks = umem::mem<_Allocator, seqlock[]>::alloc(
        num_cls, [] __host__ __device__(std::size_t id, seqlock * seqlock) { seqlock->init(); });
    auto set_cnts = umem::mem<_Allocator, unsigned[]>::alloc(
        num_cls / _Ways, [] __host__ __device__(std::size_t id, unsigned * cnt) { *cnt = 0; });
    typename cache<_Sco, _CL_Ref, _Ways>::template handle<_Allocator>::template ptr<meta_type> meta = nullptr;
    typename cache<_Sco, _CL_Ref, _Ways>::template handle<_Allocator>::template ptr<set_meta_type> set_meta = nullptr;

    if constexpr (!std::is_same_v<meta_type, nullmeta_t>)
        meta = umem::mem<_Allocator, meta_type[]>::alloc(num_cls);

    if constexpr (!std::is_same_v<set_meta_type, nullsetmeta_t>)
        set_meta = umem::mem<_Allocator, set_meta_type[]>::alloc(num_cls / _Ways);

    auto _cl_ids = cl_ids.get();
    auto _meta = meta.get();
    auto _set_meta = set_meta.get();

    auto cl_refs = umem::mem<_Allocator, cl_ref_type[]>::alloc(
        num_cls, [data_ptr, _cl_ids, _meta, _set_meta] __host__ __device__(std::size_t id, cl_ref_type * cl_ref) {
            new (cl_ref) cl_ref_type(id, _cl_ids[id], data_ptr + id * cl_size,
                _meta == nullptr ? nullptr : (_meta + id), _set_meta == nullptr ? nullptr : (_set_meta + id / _Ways));
        });

    auto _cache = umem::mem<_Allocator, cache>::alloc(num_cls, data_ptr, cl_ids.get(), meta.get(), set_meta.get(),
        cl_refs.get(), set_seqlocks.get(), cl_seqlocks.get(), set_cnts.get());
    return typename cache<_Sco, _CL_Ref, _Ways>::template handle<_Allocator>(num_cls, data_ptr, std::move(cl_ids),
        std::move(meta), std::move(set_meta), std::move(cl_refs), std::move(set_seqlocks), std::move(cl_seqlocks),
        std::move(set_cnts), std::move(_cache));
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Allocator>
inline cache<_Sco, _CL_Ref, _Ways>::handle<_Allocator>::handle(std::size_t num_cls, val_type * data_ptr,
    ptr<cl_id_type> && cls_ids, ptr<meta_type> && meta, ptr<set_meta_type> && set_meta, ptr<cl_ref_type> && cl_refs,
    ptr<seqlock> && set_seqlocks, ptr<seqlock> && cl_seqlocks, ptr<unsigned> && set_cnts, ptr<cache> && cache) noexcept
    : cl_ids_(std::move(cls_ids)),
      meta_(std::move(meta)),
      set_meta_(std::move(set_meta)),
      cl_refs_(std::move(cl_refs)),
      set_seqlocks_(std::move(set_seqlocks)),
      cl_seqlocks_(std::move(cl_seqlocks)),
      set_cnts_(std::move(set_cnts)),
      num_cls_(num_cls),
      cache_(std::move(cache)) {}

