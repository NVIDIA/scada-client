    unsigned set_before, set_after;
    unsigned way = _Ways;
    bool cont = true;
    auto set_id_ = set_id(cl_id_, policies);
    do {
        set_before = single_thread_broadcast(group, [this, set_id_] { return this->set_seqlock(set_id_).read_lock(); });

        way = search_ways_group(group, cl_id_, set_id_);

        if (way < _Ways) {
            unsigned way_before = single_thread_broadcast(
                group, [this, set_id_, way] { return this->cl_seqlock(set_id_, way).read_lock(); });

            auto way_cl_id = single_thread_broadcast(group, [this, set_id_, way] { return this->cl_id(set_id_, way); });

            if ((cl_id_ == way_cl_id)) {
                memcpy_(&val_, val(set_id_, way, cl_offset), sizeof(val_type));
            }

            auto way_after = single_thread_broadcast(
                group, [this, set_id_, way] { return this->cl_seqlock(set_id_, way).read_unlock(); });
            if ((cl_id_ == way_cl_id) and (way_before == way_after))
                return 0;
        }

        set_after
            = single_thread_broadcast(group, [this, set_id_] { return this->set_seqlock(set_id_).read_unlock(); });
        cont = set_before != set_after;
    } while (cont);

    return -ENOENT;
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Policies>
__host__ __device__ inline int cache<_Sco, _CL_Ref, _Ways>::get(
    const key_type & key, val_type & val_, const _Policies & policies) noexcept {
#if defined(__CUDA_ARCH__)
    auto active_group = cooperative_groups::coalesced_threads();
#else
    unsigned active_group = 1;
#endif

    auto cl_id_ = cl_id(key, policies);
    auto cl_offset_ = cl_offset(key, policies);
    auto set_id_ = set_id(cl_id_, policies);

#if defined(__CUDA_ARCH__)
    auto cl_group = cooperative_groups::labeled_partition(active_group, static_cast<std::uint64_t>(cl_id_));
#else
    unsigned cl_group = active_group;
#endif

    auto ret = __get_hit_group(
        cl_group, cl_id_, cl_offset_, val_, policies, [](val_type * dst, val_type * src, const size_t bytes) {
            ::memcpy(reinterpret_cast<void *>(dst), src, bytes);
        });

#if defined(__CUDA_ARCH__)
    auto new_cl_group = cooperative_groups::binary_partition(cl_group, (ret == -ENOENT));
#else
    unsigned new_cl_group = 1;
#endif

    unsigned way = _Ways;

    if (ret == -ENOENT) {
        ret = miss_prologue(
            new_cl_group, cl_id_, cl_offset_, val_, way, policies,
            [this](auto & group, const set_id_type set_id, const _Policies & policies) {
                return single_thread_broadcast(
                    group, [this, set_id, &policies] { return this->evict_thread(set_id, policies); });
            },
            [this](auto & group, const set_id_type & set_id, const unsigned way, const cl_id_type & cl_id,
                const _Policies & policies) {
                return single_thread_broadcast(group, [this, &set_id, way, &cl_id, &policies] {
                    auto ret = this->victim_thread(set_id, way, policies);
                    this->cl_id(set_id, way) = cl_id;
                    return ret;
                });
            },
            [this](auto & group, const set_id_type & set_id, const unsigned way, const cl_id_type & cl_id,
                const _Policies & policies) {
                return single_thread_broadcast(group, [this, &set_id, way, &policies] {
                    int ret = this->miss_thread(set_id, way, policies);
                    if (ret < 0)
                        this->cl_id(set_id, way) = invalid_cl_id;
                    return ret;
                });
            });

        if (ret == 0)
            ::memcpy(reinterpret_cast<void *>(&val_), val(set_id_, way, cl_offset_), sizeof(val_type));

        miss_epilogue(new_cl_group, cl_id_, set_id_, way);
    }

    return ret;
}

