template<typename _Policies>
__host__ __device__ inline unsigned cache<_Sco, _CL_Ref, _Ways>::cl_offset(
    const key_type & key, const _Policies & policies) const noexcept {
    if constexpr (!std::is_same_v<undefined_policy_type, decltype(policies.key_to_cl_offset())>)
        return policies.key_to_cl_offset()(key);
    else
        return key % cl_size;
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Policies>
__host__ __device__ inline typename cache<_Sco, _CL_Ref, _Ways>::set_id_type cache<_Sco, _CL_Ref, _Ways>::set_id(
    const cl_id_type cl_id, const _Policies & policies) const noexcept {
    if constexpr (!std::is_same_v<undefined_policy_type, decltype(policies.cl_to_set())>)
        return policies.cl_to_set()(cl_id, num_sets_);
    else
        return cl_id % num_sets_;
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Policies>
__host__ __device__ inline typename cache<_Sco, _CL_Ref, _Ways>::key_type cache<_Sco, _CL_Ref, _Ways>::nth_key_of_cl(
    const cl_id_type cl_id, const unsigned n, const _Policies & policies) const noexcept {
