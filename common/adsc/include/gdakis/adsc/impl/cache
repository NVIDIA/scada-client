}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
__host__ __device__ inline void cache<_Sco, _CL_Ref, _Ways>::invalidate_cl(cl_ref_type & ref) const noexcept {
    std::size_t id = &ref - cl_refs_;
    if (id < num_cls_) {
        cl_seqlocks_[id].write_lock();
        ref.invalidate();
        cl_seqlocks_[id].write_unlock();
    }
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Policies>
__host__ __device__ inline void cache<_Sco, _CL_Ref, _Ways>::flush_cl(
    cl_ref_type & ref, const _Policies & policies) noexcept {
    std::size_t id = &ref - cl_refs_;
    if (id < num_cls_) {
        cl_seqlocks_[id].write_lock();
        auto set = id / _Ways;
        auto way = id % _Ways;
        victim_thread(set, way, policies);
        ref.mark_clean();
        cl_seqlocks_[id].write_unlock();
    }
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
__host__ __device__ inline typename _CL_Ref::val_type * cache<_Sco, _CL_Ref, _Ways>::val(
    const set_id_type set_id, const unsigned way, const std::size_t cl_offset) noexcept {
    return vals_ + ((((set_id * _Ways) + way) * cl_size) + cl_offset);
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Group>
__host__ __device__ inline unsigned cache<_Sco, _CL_Ref, _Ways>::search_ways_group(
    const _Group & group, const cl_id_type cl_id, const set_id_type set_id) const noexcept {
#if defined(__CUDA_ARCH__)
    auto effective_lane_id = group.thread_rank();
    auto group_count = group.size();
#else
    auto group_count = popc(group);
    auto lane_id = 0;
    auto effective_lane_id = popc(group & ((1 << lane_id) - 1));

#endif
    auto cl_ids = cl_ids_ + set_id * _Ways;

    bool is_found = false;
    unsigned way = _Ways;
    /* If using cooperative groups, get the make rank0 as the leader by default. If the below loop
       is not able to change the value of the way then this selected leader will shuffle the value which is 32, else
       shuffling will be done by the one that's breaking the loop
     */
#if defined(__CUDA_ARCH__)
    auto leader = 0;
#endif
    for (unsigned i = effective_lane_id; i < _Ways; i += group_count) {
        is_found = cl_id == cl_ids[i];
        if (is_found) {
            way = i;
#if defined(__CUDA_ARCH__)
            leader = group.thread_rank();
#endif
            break;
        }
    }
#if defined(__CUDA_ARCH__)
    leader = cooperative_groups::reduce(group, leader, cooperative_groups::greater<int>());
    way = group.shfl(way, leader);
#endif
    return way;
}

#if defined(__CUDACC__)

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Group, typename _Policies>
__device__ inline int cache<_Sco, _CL_Ref, _Ways>::miss_group(
    const _Group & group, const set_id_type set_id, const unsigned way, const _Policies & access_policies) noexcept {
    if constexpr (!std::is_same_v<undefined_policy_type, decltype(access_policies.miss())>)
        return access_policies.miss()(group, cl_ref(set_id, way));
    else
        return 0;
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Group, typename _Policies>
__device__ inline unsigned cache<_Sco, _CL_Ref, _Ways>::evict_group(
    const _Group & group, const set_id_type set_id, const _Policies & access_policies) noexcept {
    set_meta_type & set_meta = set_meta_[set_id];

    if constexpr (!std::is_same_v<undefined_policy_type, decltype(access_policies.evict())>)
        return access_policies.evict()(group, set_meta) % _Ways;
    else
        return single_thread_broadcast(group, [this, set_id] { return this->set_cnts_[set_id]++ % _Ways; });
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Group, typename _Policies>
__device__ inline int cache<_Sco, _CL_Ref, _Ways>::victim_group(
    const _Group & group, const set_id_type set_id, const unsigned way, const _Policies & access_policies) noexcept {
    if constexpr (!std::is_same_v<undefined_policy_type, decltype(access_policies.victim())>)
        return access_policies.victim()(group, cl_ref(set_id, way));
    else
        return 0;
}

