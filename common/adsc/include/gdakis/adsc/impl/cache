template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
__host__ __device__ inline _CL_Ref & cache<_Sco, _CL_Ref, _Ways>::cl_ref(
    const set_id_type set_id, const unsigned way) noexcept {
    return cl_refs_[set_id * _Ways + way];
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Policies>
__host__ __device__ inline typename cache<_Sco, _CL_Ref, _Ways>::cl_id_type cache<_Sco, _CL_Ref, _Ways>::cl_id(
    const key_type & key, const _Policies & policies) const noexcept {
    if constexpr (!std::is_same_v<undefined_policy_type, decltype(policies.key_to_cl_id())>)
        return policies.key_to_cl_id()(key);
    else
        return key / cl_size;
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
__host__ __device__ inline typename cache<_Sco, _CL_Ref, _Ways>::cl_id_type & cache<_Sco, _CL_Ref, _Ways>::cl_id(
    const _CL_Ref & cl_ref) noexcept {
    return cl_ref.cl_id();
}

