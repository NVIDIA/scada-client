__device__ void cache<_Sco, _CL_Ref, _Ways>::copy_cl_data(
    const _Group & group, const set_id_type set_id, const unsigned way, val_type * dst, const size_t bytes) noexcept {
    val_type * src = cl_ref(set_id, way).vals();
    group_memcpy(group, dst, src, bytes);
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Group, typename _Access_Policies, typename _Victim_Processing>
__device__ inline int cache<_Sco, _CL_Ref, _Ways>::access_async_group(const _Group & group, const cl_id_type & cl_id,
    set_id_type & set_id_, unsigned & way, bool & is_cache_hit, const _Access_Policies & policies,
    _Victim_Processing && victim_process) noexcept {
    // Enforce that each thread uses its own single-thread group to avoid divergence deadlocks
    assert(group.size() == 1
        && "access_async_group must be called with single-thread group when threads have different cl_ids");

    // Try cache hit first - call async_hit_prologue
    int ret = async_hit_prologue(group, cl_id, set_id_, way, policies);
    if (ret == 0) {
        // Cache hit!
        is_cache_hit = true;
    } else {
        //Cache miss - acquire cache line via async_miss_prologue
        ret = async_miss_prologue(
            group, cl_id, set_id_, way, policies,
            [this](
                const auto & g, const set_id_type sid, const auto & pols) { return this->evict_group(g, sid, pols); },
            std::forward<_Victim_Processing>(victim_process));

        // Set is_cache_hit based on whether miss prologue succeeded or not
        is_cache_hit = false;
    }

    // 0 : miss prologue succeeded
    // -ENOENT : miss prologue failed
    return ret; // Return with CL lock held if ret == 0
}

