    seqlock * cl_seqlocks, unsigned * set_cnts) noexcept
    : num_cls_(num_cls),
      num_sets_(num_cls / _Ways),
      set_seqlocks_(set_seqlocks),
      cl_seqlocks_(cl_seqlocks),
      set_cnts_(set_cnts),
      cl_ids_(cl_ids),
      vals_(data_ptr),
      meta_(meta),
      set_meta_(set_meta),
      cl_refs_(cl_refs) {}

