template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Group, typename _Policies, typename _Memcpy>
__host__ __device__ inline int cache<_Sco, _CL_Ref, _Ways>::__get_hit_group(const _Group & group,
