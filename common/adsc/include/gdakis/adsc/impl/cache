template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Policies>
__host__ __device__ inline unsigned cache<_Sco, _CL_Ref, _Ways>::evict_thread(
    const set_id_type set_id, const _Policies & access_policies) noexcept {
    set_meta_type & set_meta = set_meta_[set_id];

    if constexpr (!std::is_same_v<undefined_policy_type, decltype(access_policies.evict())>)
        return access_policies.evict()(set_meta) % _Ways;
    else
        return set_cnts_[set_id]++ % _Ways;
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Policies>
__host__ __device__ inline int cache<_Sco, _CL_Ref, _Ways>::miss_thread(
    const set_id_type set_id, const unsigned way, const _Policies & access_policies) noexcept {
    if constexpr (!std::is_same_v<undefined_policy_type, decltype(access_policies.miss())>)
        return access_policies.miss()(cl_ref(set_id, way));
    else
        return 0;
}

template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Policies>
__host__ __device__ inline int cache<_Sco, _CL_Ref, _Ways>::victim_thread(
    const set_id_type set_id, const unsigned way, const _Policies & access_policies) noexcept {
    if constexpr (!std::is_same_v<undefined_policy_type, decltype(access_policies.victim())>) {
        auto & ref = cl_ref(set_id, way);
        return access_policies.victim()(ref);
    }
    return 0;
}

