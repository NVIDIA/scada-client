template<thread_scope _Sco, typename _CL_Ref, unsigned _Ways>
template<typename _Group, typename _Policies>
__device__ inline int cache<_Sco, _CL_Ref, _Ways>::put_group(
    const _Group & group, const key_type & key, const val_type & val_, const _Policies & policies) noexcept {
    auto cl_id_ = cl_id(key, policies);
    auto cl_offset_ = cl_offset(key, policies);

    auto set_id_ = set_id(cl_id_, policies);

    unsigned way = _Ways;

    auto ret = miss_prologue(
        group, cl_id_, cl_offset_, val_, way, policies,
        [this](auto & group, const set_id_type set_id, const _Policies & policies) {
            return this->evict_group(group, set_id, policies);
        },
        [this](auto & group, const set_id_type & set_id, unsigned way, const cl_id_type & cl_id,
            const _Policies & policies) {
            auto ret = this->victim_group(group, set_id, way, policies);
            single_thread(group, [this, set_id, way, &cl_id, policies] { this->cl_id(set_id, way) = cl_id; });

            return ret;
        },
        [this](auto & group, const set_id_type & set_id, unsigned way, const cl_id_type & cl_id,
            const _Policies & policies) {
            // put_group replaces the entire line when it contains only one value.
            if constexpr (cl_size == 1) {
                return 0;
            }
            int ret = this->miss_group(group, set_id, way, policies);
#  if defined(__CUDA_ARCH__)
            auto error_group = group.ballot(ret != 0);
            if (error_group)
                this->cl_id(set_id, way) = invalid_cl_id;
            ret = group.shfl(ret, __ffs(error_group));
#  else
            auto error_group = gdakis::utils::cuda::this_warp::ballot(group, ret != 0);
            if (error_group)
                this->cl_id(set_id, way) = invalid_cl_id;
            ret = gdakis::utils::cuda::this_warp::shuffle(group, ret, ffs(error_group));
#  endif
            return ret;
        });

    if (ret == 0) {
        group_memcpy(group, val(set_id_, way, cl_offset_), &val_, sizeof(val_type));
        cl_ref(set_id_, way).mark_dirty();
    }

    miss_epilogue(group, cl_id_, set_id_, way);

    return ret;
}

