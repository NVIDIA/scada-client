inline bool cuda::supports_dma_buf_from_driver() noexcept {
    cudaError_t cuda_ret;
    CUresult cu_ret;
    CUdevice cu_device;
    int device, attr;

    cuda_ret = cudaGetDevice(&device);
    if (cuda_ret != cudaSuccess)
        return false;

    cu_ret = cuDeviceGet(&cu_device, device);
    if (cu_ret != CUDA_SUCCESS)
        return false;

    cu_ret = cuDeviceGetAttribute(&attr, CU_DEVICE_ATTRIBUTE_DMA_BUF_SUPPORTED, cu_device);
    return (cu_ret == CUDA_SUCCESS) and (attr != 0) ? true : false;
}

inline ssize_t cuda::get_page_size() noexcept {
    int device;
    cudaError_t cuda_ret = cudaGetDevice(&device);
    if (cuda_ret != cudaSuccess)
        return -EIO;

    std::size_t granularity;
    CUmemAllocationProp prop = {};
    prop.type = CU_MEM_ALLOCATION_TYPE_PINNED;
    prop.location.id = device;
    prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
    CUresult cu_ret = cuMemGetAllocationGranularity(&granularity, &prop, CU_MEM_ALLOC_GRANULARITY_MINIMUM);
    return cu_ret == CUDA_SUCCESS ? static_cast<ssize_t>(granularity) : -EIO;
}

inline cuda::ptr_type cuda::alloc(std::size_t size) noexcept {
    cudaError_t ret;
    void * p;

    ret = cudaMalloc(&p, size);
    if (ret != cudaSuccess)
        return nullptr;
    return ptr_type(p, [](void * p) { cudaFreeAsync(p, get_stream()); });
}

inline cuda::ptr_type cuda::alloc_system(std::size_t size) noexcept {
    cudaError_t ret;
    void * p;

    ret = cudaHostAlloc(&p, size, cudaHostAllocMapped | cudaHostAllocPortable);
    if (ret != cudaSuccess)
        return nullptr;
    return ptr_type(p, [](void * p) { cudaFreeHost(p); });
}

inline cuda::ptr_type cuda::alloc_pages_shared(std::size_t) noexcept {
    return nullptr;
}

template<typename _Tp>
inline cuda::dma_buffer_type<_Tp> cuda::alloc_dma_buffer(std::size_t size) noexcept {
    cudaError_t cuda_ret;
    CUresult cu_ret;
    if (supports_dma_buf_from_driver() == false) {
        std::cerr
            << "CUDA DMA Buffer allocation failed: GPU does not support DMA-BUF (CU_DEVICE_ATTRIBUTE_DMA_BUF_SUPPORTED)"
            << std::endl;
        return dma_buffer_type<_Tp>(-ENOSYS);
    }

    int device;
    cuda_ret = cudaGetDevice(&device);
    if (cuda_ret != cudaSuccess) {
        std::cerr << "CUDA DMA Buffer allocation failed: cudaGetDevice() returned " << cuda_ret << " ("
                  << cudaGetErrorString(cuda_ret) << ")" << std::endl;
        return dma_buffer_type<_Tp>(-EIO);
    }

    CUmemGenericAllocationHandle handle;
    CUmemAllocationProp prop = {};
    prop.type = CU_MEM_ALLOCATION_TYPE_PINNED;
    prop.location.id = device;
    prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;

    std::size_t granularity;
    cu_ret = ::cuMemGetAllocationGranularity(&granularity, &prop, CU_MEM_ALLOC_GRANULARITY_MINIMUM);
    if (cu_ret != CUDA_SUCCESS) {
        std::cerr << "CUDA DMA Buffer allocation failed: cuMemGetAllocationGranularity() returned " << cu_ret
                  << " (requested size: " << size << " bytes)" << std::endl;
        return dma_buffer_type<_Tp>(-EIO);
    }

    std::size_t mem_size = ((size + granularity - 1) / granularity) * granularity;

    cu_ret = ::cuMemCreate(&handle, mem_size, &prop, 0);
    if (cu_ret != CUDA_SUCCESS) {
        std::cerr << "CUDA DMA Buffer allocation failed: cuMemCreate() returned " << cu_ret << " (size: " << mem_size
                  << " bytes, device: " << device << ")" << std::endl;
        std::cerr << "  Possible causes: GPU out of memory, too many allocations, or memory fragmentation" << std::endl;
        return dma_buffer_type<_Tp>(-ENOMEM);
    }

    CUdeviceptr ptr;
    cu_ret = ::cuMemAddressReserve(&ptr, mem_size, granularity, 0, 0);
    if (cu_ret != CUDA_SUCCESS) {
        std::cerr << "CUDA DMA Buffer allocation failed: cuMemAddressReserve() returned " << cu_ret
                  << " (size: " << mem_size << " bytes)" << std::endl;
        std::cerr << "  Possible cause: Virtual address space exhaustion" << std::endl;
        cuMemRelease(handle);
        return dma_buffer_type<_Tp>(-ENOMEM);
    }

    cu_ret = ::cuMemMap(ptr, mem_size, 0, handle, 0);
    if (cu_ret != CUDA_SUCCESS) {
        std::cerr << "CUDA DMA Buffer allocation failed: cuMemMap() returned " << cu_ret << " (ptr: 0x" << std::hex
                  << ptr << std::dec << ", size: " << mem_size << ")" << std::endl;
        ::cuMemRelease(handle);
        ::cuMemAddressFree(ptr, mem_size);
        return dma_buffer_type<_Tp>(-ENOMEM);
    }

    CUmemAccessDesc access = {};
    access.location.id = device;
    access.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
    access.flags = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
    cu_ret = ::cuMemSetAccess(ptr, mem_size, &access, 1);
    if (cu_ret != CUDA_SUCCESS) {
        std::cerr << "CUDA DMA Buffer allocation failed: cuMemSetAccess() returned " << cu_ret << " (device: " << device
                  << ")" << std::endl;
        ::cuMemUnmap(ptr, mem_size);
        ::cuMemRelease(handle);
        ::cuMemAddressFree(ptr, mem_size);
        return dma_buffer_type<_Tp>(-EACCES);
    }

    int _fd;
    cu_ret = ::cuMemGetHandleForAddressRange(&_fd, ptr, mem_size, CU_MEM_RANGE_HANDLE_TYPE_DMA_BUF_FD, 0);
    if (cu_ret != CUDA_SUCCESS) {
        std::cerr << "CUDA DMA Buffer allocation failed: cuMemGetHandleForAddressRange() returned " << cu_ret
                  << " (size: " << mem_size << " bytes)" << std::endl;
        std::cerr << "  Possible causes: DMA-BUF export not supported, file descriptor limit reached" << std::endl;
        ::cuMemUnmap(ptr, mem_size);
        ::cuMemRelease(handle);
        ::cuMemAddressFree(ptr, mem_size);
        return dma_buffer_type<_Tp>(-EINVAL);
    }

    return dma_buffer_type<_Tp>(
        fd(_fd), typename dma_buffer_type<_Tp>::mem(reinterpret_cast<_Tp *>(ptr), [mem_size, handle](_Tp * p) {
            CUdeviceptr ptr = reinterpret_cast<CUdeviceptr>(p);
            ::cuMemUnmap(ptr, mem_size);
            ::cuMemRelease(handle);
            ::cuMemAddressFree(ptr, mem_size);
        }));
}

