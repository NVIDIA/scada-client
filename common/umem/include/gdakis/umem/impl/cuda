namespace detail {

template<typename _Tp, typename _Fn>
__global__ static void map_kernel(_Tp * ptr, std::size_t n_elems, _Fn fn) {
    unsigned id = threadIdx.x + blockIdx.x * blockDim.x;
    if (id >= n_elems)
        return;
    fn(id, ptr + id);
}

}

template<typename _Tp, typename _Fn>
inline bool cuda::call_map(_Tp * p, std::size_t n_elems, _Fn && fn) noexcept {
    static const std::size_t block_size = 128;

    dim3 block(n_elems > block_size ? block_size : n_elems);
    dim3 grid((n_elems + block.x - 1) / block.x);
    detail::map_kernel<<<grid, block, 0, get_stream()>>>(p, n_elems, fn);
    cudaError_t ret = cudaStreamSynchronize(get_stream());
    return ret == cudaSuccess;
}
#  endif

inline void cuda::memset(void * ptr, int c, std::size_t size) noexcept {
#  if !defined(NDEBUG)
    cudaError_t cuda_ret =
#  endif
        cudaMemsetAsync(ptr, c, size, get_stream());
    assert(cuda_ret == cudaSuccess);
}

inline void cuda::memcpy(void * dst, const void * src, std::size_t size) noexcept {
#  if !defined(NDEBUG)
    cudaError_t cuda_ret =
#  endif
        cudaMemcpyAsync(dst, src, size, cudaMemcpyDefault, get_stream());
    assert(cuda_ret == cudaSuccess);
}

