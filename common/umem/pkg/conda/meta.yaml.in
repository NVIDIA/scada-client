    name: "@PROJECT_NAME@"
    version : "@PROJECT_VERSION@"

source:
    git_rev: "main"
    git_url: "https://github.com/NVIDIA/scada-client.git"

requirements:
    build:
        - cmake
    run:
        - {{ compiler('cxx') }}
