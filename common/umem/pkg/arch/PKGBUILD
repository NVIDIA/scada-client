pkgname='gdakis-umem-dev'
pkgdesc='GDAKIS C++ Memory Allocators'
arch=('x86_64')
pkgver=1.0.0
pkgrel=1

source=('git+https://github.com/NVIDIA/scada-client.git')
sha256sums=('SKIP')

prepare() {
    cmake -B build -S scada-client/common/umem \
    -DGDAKIS_UMEM_BUILD_TESTS=BOOL:ON \
    -DGDAKIS_UMEM_BUILD_DOCS=BOOL:ON \
    -DCMAKE_BUILD_TYPE='Release' \
    -DCMAKE_INSTALL_PREFIX='/usr' \
    -Wno-dev
}

build() {
   cmake --build build -j`nproc`
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
