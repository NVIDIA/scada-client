    autobatch_handle && autobatch, io_buffer_pool_handle && io_buffers, adsc_handle && adsc) noexcept
    : autobatch_(std::move(autobatch)),
      io_buffers_(std::move(io_buffers)),
      adsc_(std::move(adsc)),
