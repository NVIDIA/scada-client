          autobatch_.get(), io_buffers_.get(), adsc_.get())) {}

template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
    unsigned _Ways>
inline portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways> *
portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::handle_type::get() const noexcept {
    return portal_.get();
}

template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
    unsigned _Ways>
inline void portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::handle_type::sync(
    const gdakis::memory_order order) const noexcept {
    if (order == gdakis::memory_order_acquire)
        adsc_.invalidate_cache();
    else if (order == gdakis::memory_order_release) {
        auto portal_ptr = portal_.get();
        if constexpr (_Device == device_type::cuda) {
            adsc_.flush_cache(gdakis::adsc::make_policies(
                gdakis::adsc::undefined_policy(), gdakis::adsc::undefined_policy(),
                [portal_ptr] __device__(adsc_cl_ref_type & cl_ref) { return victim_fn(portal_ptr, cl_ref); },
                gdakis::adsc::undefined_policy(), gdakis::adsc::undefined_policy(), gdakis::adsc::undefined_policy(),
                gdakis::adsc::undefined_policy()));
        } else {
            adsc_.flush_cache(gdakis::adsc::make_policies(
                gdakis::adsc::undefined_policy(), gdakis::adsc::undefined_policy(),
                [portal_ptr](adsc_cl_ref_type & cl_ref) { return portal_ptr->victim_handler(cl_ref); },
                gdakis::adsc::undefined_policy(), gdakis::adsc::undefined_policy(), gdakis::adsc::undefined_policy(),
                gdakis::adsc::undefined_policy()));
        }
    }
}

template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
