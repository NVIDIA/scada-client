template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
    unsigned _Ways>
inline __host__ __device__ int portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::miss_handler(
    adsc_cl_ref_type & cl_ref) noexcept {
    auto cl_line = cl_ref.cl_buffer_offset();
    auto index = cl_ref.cl_id();
    auto status_atom = gdakis::atomic_ref<status_type, _Sco>(this->io_pool_.status()[cl_line]);
    status_atom.store(status_type::pending);
    this->autobatch_->push([&](wqe_type & wqe) {
        wqe.op_ = operation::get;
        wqe.data_.slab_id_ = index.id;
        wqe.data_.key_ = index.offset;
        wqe.data_.n_elems_ = 1;
        wqe.data_.io_id_ = this->io_pool_.id();
        wqe.data_.io_offset_ = cl_line;
        wqe.data_.access_granularity_ = access_granularity;
    });

    unsigned backoff = min_backoff_;
    status_type status;
    do {
        status = status_atom.load(gdakis::memory_order_acquire);
        if (status != status_type::pending)
            break;

        gdakis::this_thread::nanosleep(backoff);
        if (backoff < max_backoff_)
            backoff *= 2;
    } while (true);
    if (status != status_type::ok)
        return -EIO;
    return 0;
}

template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
    unsigned _Ways>
inline __host__ __device__ int portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::victim_handler(
    adsc_cl_ref_type & cl_ref) noexcept {
    auto cl_line = cl_ref.cl_buffer_offset();
    auto index = cl_ref.cl_id();
    if (cl_ref.is_dirty()) {
        auto status_atom = gdakis::atomic_ref<status_type, _Sco>(this->io_pool_.status()[cl_line]);
        status_atom.store(status_type::pending);
        this->autobatch_->push([&](wqe_type & wqe) {
            wqe.op_ = operation::put;
            wqe.data_.slab_id_ = index.id;
            wqe.data_.key_ = index.offset;
            wqe.data_.n_elems_ = 1;
            wqe.data_.io_id_ = this->io_pool_.id();
            wqe.data_.io_offset_ = cl_line;
            wqe.data_.access_granularity_ = access_granularity;
        });

        unsigned backoff = min_backoff_;
        status_type status;
        do {
            status = status_atom.load(gdakis::memory_order_acquire);
            if (status != status_type::pending)
                break;

            gdakis::this_thread::nanosleep(backoff);
            if (backoff < max_backoff_)
                backoff *= 2;
        } while (true);

        if (status != status_type::ok)
            return -EIO;
    }
    return 0;
}

template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
    unsigned _Ways>
inline __host__ __device__ typename portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::adsc_type::cl_id_type
portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::key_to_cl_id(const index_type key) const noexcept {
    return index_type { .offset = key.offset / cl_size, .id = key.id };
}

template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
    unsigned _Ways>
inline __host__ __device__ unsigned portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::key_to_cl_offset(
    const index_type key) const noexcept {
    return key.offset % cl_size;
}

template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
    unsigned _Ways>
inline __host__ __device__ typename portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::adsc_type::set_id_type
portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::cl_to_set(
    const index_type cl_id, const unsigned num_sets) const noexcept {
    return cl_id.offset % num_sets;
}

template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
    unsigned _Ways>
inline __host__ __device__ typename portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::index_type
portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::nth_key_of_cl(
    const index_type cl_id, const unsigned n) const noexcept {
    return index_type { .offset = cl_id.offset * cl_size + n, .id = cl_id.id };
}

// ========== Async I/O Implementation ==========

#if defined(__CUDACC__) or defined(__DOXYGEN__)

template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
    unsigned _Ways>
inline __device__ bool portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::check_io_completion(
    apply_sm::state_t & state) noexcept {
    // Load status with acquire semantics
    auto status_atom = gdakis::atomic_ref<status_type, _Sco>(this->io_pool_.status()[state.cl_line()]);
    auto status = status_atom.load(gdakis::memory_order_acquire);

    if (status != status_type::pending && status == status_type::ok) {
        // I/O complete
        // printf("DEBUG: I/O complete, status=%d\n", status);
        return true;
    } else if (status != status_type::pending && status == status_type::invalid) {
        // I/O failed
        //printf("ERROR: I/O failed, status=%d\n", status);
        return false;
    }

    return false;
}

template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
    unsigned _Ways>
template<typename _Cg>
inline __device__ void portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::release_cl(
    const _Cg & group, apply_sm::state_t & state) noexcept {
    namespace cg = cooperative_groups;

    // Use single-thread group for ADSC operations to avoid group.sync() issues
    auto thread_group = cg::this_thread();

    // Unlock cache line - call cache's async_epilogue
    adsc_->async_epilogue(thread_group, state.set_id(), state.way());

    state.holding_cl_lock() = false;
    // Mark io_pool slot as available if this was I/O path
    if (!state.is_cache_hit()) {
        // Note: Still use original group param since this is just setting a flag
        cg::invoke_one_broadcast(group, [this, &state] {
            auto status_atom = gdakis::atomic_ref<status_type, _Sco>(this->io_pool_.status()[state.cl_line()]);
            status_atom.store(status_type::invalid);
            return 0;
        });
    }
}

template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
    unsigned _Ways>
template<typename _Cg>
inline __device__ result<none_type> portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::access_async_group(
    const _Cg & group, index_type idx, apply_sm::state_t & state) noexcept {
    namespace cg = cooperative_groups;
    auto thread_group = cg::this_thread();

    if (state.is_invalid()) {
        // Compute cache line ID
        auto cl_id = key_to_cl_id(idx);
        typename adsc_type::set_id_type set_id;
        unsigned way;
        bool is_cache_hit;

        // Call cache's access_async_group with single-thread group
        int ret = adsc_->access_async_group(thread_group, cl_id, set_id, way, is_cache_hit,
            gdakis::adsc::make_policies(
                gdakis::adsc::undefined_policy(), gdakis::adsc::undefined_policy(), gdakis::adsc::undefined_policy(),
                [this](const index_type key) { return this->key_to_cl_id(key); },
                [this](const index_type key) { return this->key_to_cl_offset(key); },
                [this](const index_type cl_id, const unsigned num_sets) { return this->cl_to_set(cl_id, num_sets); },
                [this](const index_type cl_id, const unsigned n) { return this->nth_key_of_cl(cl_id, n); }),
            [this](const auto & g, const typename adsc_type::set_id_type & sid, const unsigned w,
                const typename adsc_type::cl_id_type & cid, const auto & policies) {
                return cg::invoke_one_broadcast(
                    g, [this, sid, w] { return this->victim_handler(this->adsc_->cl_ref(sid, w)); });
            });

        if (ret != 0) {
            // Failed to acquire cache line
            state.holding_cl_lock() = false;
            state.set_invalid();
        } else {
            // Update state with cache acquisition results
            state.set_id() = set_id;
            state.way() = way;
            state.holding_cl_lock() = true;
            state.is_cache_hit() = is_cache_hit;

            if (state.is_cache_hit()) {
                // Cache hit - data is ready immediately
                state.set_ready();
            } else {
                // This MUST match how ADSC computes cl_ref index: set_id * num_ways + way
                unsigned cl_line = set_id * adsc_type::num_ways + way;
                state.cl_line() = cl_line;
                cg::invoke_one_broadcast(thread_group, [this, idx, cl_line, &state] {
                    auto status_atom = gdakis::atomic_ref<status_type, _Sco>(this->io_pool_.status()[cl_line]);
                    status_atom.store(status_type::pending);
                    this->autobatch_->push([this, idx, cl_line](wqe_type & wqe) {
                        wqe.op_ = operation::get;
                        wqe.data_.slab_id_ = idx.id;
                        wqe.data_.key_ = idx.offset;
                        wqe.data_.n_elems_ = 1;
                        wqe.data_.io_id_ = this->io_pool_.id();
                        wqe.data_.io_offset_ = cl_line;
                        wqe.data_.access_granularity_ = access_granularity;
                    });
                    return 0;
                });
                state.set_valid();
            }
        }
    }

    // Return error status, but only AFTER all threads are synchronized
    if (!state.is_released() && state.is_invalid()) {
        return result<none_type>::err(-1);
    }
    return result<none_type>::ok<>();
}

// coop_apply implementation - cooperative work sharing version
template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
    unsigned _Ways>
template<unsigned TILESIZE, unsigned BLOCKSIZE, typename _Cg, typename _Fn>
inline __device__ result<none_type> portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::coop_apply(_Cg & group,
    apply_sm::state_t * states, index_type idx, _Tp * scratch_buffers, _Fn && callback, bool active) noexcept {
    namespace cg = cooperative_groups;

    const unsigned tid = group.thread_rank();
    const unsigned group_size = group.size();

    // Per-tile shared memory for broadcasting all_released flag
    // MUST be atomic to ensure visibility across threads in optimized builds
    constexpr unsigned TILES_PER_BLOCK = BLOCKSIZE / TILESIZE;
    __shared__ alignas(cuda::atomic<bool, cuda::thread_scope_block>) unsigned char
        all_released_flags_raw[TILES_PER_BLOCK * sizeof(cuda::atomic<bool, cuda::thread_scope_block>)];
    auto * all_released_flags
        = reinterpret_cast<cuda::atomic<bool, cuda::thread_scope_block> *>(all_released_flags_raw);
    const unsigned tile_id = group.meta_group_rank();

    // Construct and initialize atomic flag for this tile using placement new (only thread 0 of each tile)
    if (tid == 0) {
        new (&all_released_flags[tile_id]) cuda::atomic<bool, cuda::thread_scope_block>(false);
    }
    // CRITICAL: Block-level sync to ensure ALL tiles have initialized their atomics before ANY tile proceeds
    __syncthreads();

    // If thread is not active, mark as released and skip issuing I/O requests
    if (!active) {
        states[tid].set_released();
    }

    group.sync();
    access_async_group(group, idx, states[tid]);
    group.sync();

    bool all_released = false;

    while (!all_released) {
        for (unsigned i = 0; i < group_size; i++) {
            auto & work_state = states[i];
            group.sync();
            if (work_state.is_valid()) {
                // Check I/O completion cooperatively (one thread checks and sets state)
                if (group.thread_rank() == 0) {
                    if (check_io_completion(work_state)) {
                        work_state.set_ready();
                    }
                }
            }
            group.sync();
            if (work_state.is_ready()) {
                // Group cooperates to copy to scratchbuffer
                adsc_->copy_cl_data(
                    group, work_state.set_id(), work_state.way(), &scratch_buffers[i], sizeof(value_type));
                group.sync();

                if (group.thread_rank() == 0) {
                    work_state.set_released();
                    assert(work_state.holding_cl_lock() == true && "work_state should be holding the cl lock");
                    release_cl(group, work_state);
                }
                group.sync();
                // Application must copy from scratch buffer to final destination
                callback(group, scratch_buffers[i], i);
                group.sync();
            }
        }
        group.sync();
        access_async_group(group, idx, states[tid]);
        group.sync();

        // Each tile uses its own slot in the shared array (indexed by tile_id)
        if (tid == 0) {
            bool all_done = true;
            for (unsigned i = 0; i < group_size; i++) {
                if (!states[i].is_released()) {
                    all_done = false;
                    break;
                }
            }
            all_released_flags[tile_id].store(all_done, cuda::memory_order_release);
        }

        group.sync();
        all_released = all_released_flags[tile_id].load(cuda::memory_order_acquire);
    }

    group.sync();
    return result<none_type>::ok<>();
}

