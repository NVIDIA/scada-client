template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
    unsigned _Ways>
template<typename _Store>
inline result<typename portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::handle_type>
portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::build(
    _Store & store, std::size_t autobatch_size, std::size_t num_cls) noexcept {
    constexpr auto total_bytes = sizeof(value_type) * cl_size;
    static_assert(total_bytes % 3072 == 0 || (total_bytes >= 512 && (total_bytes & (total_bytes - 1)) == 0),
        "Cacheline size must be either a multiple of 3072 or a power of 2 and >= 512 (ie, supported access "
        "granularity)");
    bool is_dma = true;
    auto io_buffer_pool = io_buffer_pool_handle::build(
        num_cls, [] __host__ __device__(unsigned, cl_type * data) {},
        [] __host__ __device__(unsigned id, typename io_buffer_pool_type::status_type * status) {
            gdakis::atomic_ref<status_type, _Sco>(*status).store(status_type::pending, gdakis::memory_order_relaxed);
        },
        is_dma);
    if (io_buffer_pool.is_err()) {
        SWAP_LOG(LOCSTR, "data io buffer pool build in error state during portal build");
        return result<handle_type>::err(io_buffer_pool.err());
    }

    auto ret = io_buffer_pool.ok().send_to_server(store.socket()).sync();
    if (ret.is_err()) {
        SWAP_LOG(LOCSTR, "data io buffer pool registration in error state during portal build");
        return result<handle_type>::err(ret.err());
    }

    auto autobatch = autobatch_type::handle::build(autobatch_size);
    if (autobatch.is_err()) {
        SWAP_LOG(LOCSTR, "data autobatch build in error state during portal build");
        return result<handle_type>::err(autobatch.err());
    }

    ret = autobatch.ok().send_to_server(store.socket()).sync();
    if (ret.is_err()) {
        SWAP_LOG(LOCSTR, "data autobatch registration in error state during portal build");
        return result<handle_type>::err(ret.err());
    }

    auto adsc = adsc_type::template build<typename portal_traits<_Device>::allocator_type>(
        num_cls, reinterpret_cast<value_type *>(io_buffer_pool.ok().data()));

    return result<handle_type>::ok(handle_type(autobatch.take_ok(), io_buffer_pool.take_ok(), std::move(adsc)));
}

template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
