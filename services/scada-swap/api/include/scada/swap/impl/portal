template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
    unsigned _Ways>
inline __host__ __device__ result<_Tp> portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::get(
    index_type index) noexcept {
    _Tp temp;

    auto ret = adsc_->get(index, temp,
        gdakis::adsc::make_policies([this](adsc_cl_ref_type & cl_ref) { return this->miss_handler(cl_ref); },
            gdakis::adsc::undefined_policy(),
            [this](adsc_cl_ref_type & cl_ref) { return this->victim_handler(cl_ref); },
            [this](const index_type key) { return this->key_to_cl_id(key); },
            [this](const index_type key) { return this->key_to_cl_offset(key); },
            [this](const index_type cl_id, const unsigned num_sets) { return this->cl_to_set(cl_id, num_sets); },
            [this](const index_type cl_id, const unsigned n) { return this->nth_key_of_cl(cl_id, n); }));
    if (ret)
        return result<_Tp>::err(ret);
    return result<_Tp>::ok(temp);
}

