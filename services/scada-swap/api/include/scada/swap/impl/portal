template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
    unsigned _Ways>
inline constexpr __host__ __device__
portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::index_type::operator std::uint64_t() const noexcept {
    return (static_cast<uint64_t>(id) << 48) | offset;
}

template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
    unsigned _Ways>
inline constexpr __host__ __device__ typename portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::index_type
portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::index_type::operator+(const std::size_t i) const noexcept {
    return index_type { .offset = offset + i, .id = id };
}

template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
    unsigned _Ways>
inline constexpr __host__ __device__ typename portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::index_type
portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::index_type::invalid() noexcept {
    return index_type { .offset = 0xffffffffffff, .id = 0xffff };
}

template<typename _Tp, std::size_t _CL_Size, device_type _Device, thread_scope _Sco, std::size_t _NumBuffers,
    unsigned _Ways>
inline constexpr __host__ __device__
typename portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::accessor::reference
portal<_Tp, _CL_Size, _Device, _Sco, _NumBuffers, _Ways>::accessor::access(
    data_handle_type p, std::size_t i) const noexcept {
    return *(p + i);
}

