#ifndef SCADA_CUDA_MDSPAN_ITERATOR
#define SCADA_CUDA_MDSPAN_ITERATOR

#include <scada/__scada_cuda_version>
#include <scada/cuda/mdspan/__scada_cuda_compat>

#include <cuda/std/iterator>
#include <cuda/std/mdspan>

SCADA_CUDA_SIMPLE_NS {
namespace mdspan {
SCADA_CUDA_UNIT(iterator) {

template<typename _Tp, typename _Index, std::size_t _Extent, typename _Layout, typename _Accessor>
class iterator;

}}

SCADA_CUDA_UNIT(iterator) {

template<typename _Tp, typename _Index, std::size_t _Extent, typename _Layout, typename _Accessor>
static inline mdspan::iterator<_Tp, _Index, _Extent, _Layout, _Accessor> begin(
    const ::cuda::std::mdspan<_Tp, ::cuda::std::extents<_Index, _Extent>, _Layout, _Accessor> &) noexcept;

template<typename _Tp, typename _Index, std::size_t _Extent, typename _Layout, typename _Accessor>
static inline mdspan::iterator<_Tp, _Index, _Extent, _Layout, _Accessor> end(
    const ::cuda::std::mdspan<_Tp, ::cuda::std::extents<_Index, _Extent>, _Layout, _Accessor> &) noexcept;

}
}

SCADA_CUDA_UNIT(iterator) {

template<typename _Tp, typename _Index, std::size_t _Extent, typename _Layout, typename _Accessor>
static scada::cuda::mdspan::iterator<_Tp, _Index, _Extent, _Layout, _Accessor> operator+(
    const typename scada::cuda::mdspan::iterator<_Tp, _Index, _Extent, _Layout, _Accessor>::difference_type &,
    const scada::cuda::mdspan::iterator<_Tp, _Index, _Extent, _Layout, _Accessor> &) noexcept;

}

SCADA_CUDA_SIMPLE_NS {
namespace mdspan {
SCADA_CUDA_UNIT(iterator) {

// TODO: WAR for nvcc to work without a __builtin_is_empty.
// Without this, we run into misaligned write address when running with iterator
// after CCCL and NVCC fixes this, the code should be changed to the following
// template<typename _Tp, typename _Index, std::size_t _Extent, typename _Layout, typename _Accessor>
// class iterator {
template<typename _Tp, typename _Index, std::size_t _Extent, typename _Layout, typename _Accessor>
class alignas(64) iterator {
public:
    using value_type = _Tp;
    using difference_type = std::ptrdiff_t;

protected:
    using index_type = _Index;

public:
    using span_type = ::cuda::std::mdspan<_Tp, ::cuda::std::extents<index_type, _Extent>, _Layout, _Accessor>;
    using reference = typename span_type::reference;
    using pointer = typename span_type::data_handle_type;
    using iterator_category = ::cuda::std::random_access_iterator_tag;

protected:
    index_type index_;
    span_type span_;

    friend iterator scada::cuda::begin<_Tp, _Index, _Extent, _Layout, _Accessor>(const span_type &) noexcept;
    friend iterator scada::cuda::end<_Tp, _Index, _Extent, _Layout, _Accessor>(const span_type &) noexcept;

    // TODO: WAR for nvcc to work without a __builtin_is_empty.
    // Without this, we run into misaligned write address when running with iterator
    // after CCCL and NVCC fixes this, the code should be changed to the following
    // __host__ __device__
    // iterator(const span_type &, const index_type &) noexcept;
    __host__ __device__ iterator(const index_type &, const span_type &) noexcept;

public:
    __host__ __device__ iterator(const iterator &) noexcept;

    __host__ __device__ reference operator*() const noexcept;

    __host__ __device__ iterator operator+(const difference_type &) const noexcept;

    __host__ __device__ iterator operator-(const difference_type &) const noexcept;

    __host__ __device__ difference_type operator-(const iterator &) const noexcept;

    __host__ __device__ iterator & operator++() noexcept;

    __host__ __device__ iterator & operator--() noexcept;

    __host__ __device__ iterator & operator+=(const difference_type & idx) noexcept;

    __host__ __device__ iterator & operator-=(const difference_type & idx) noexcept;

    __host__ __device__ iterator operator++(int) noexcept;

    __host__ __device__ iterator operator--(int) noexcept;

    __host__ __device__ bool operator<(const iterator & other) const noexcept;

    __host__ __device__ bool operator>(const iterator & other) const noexcept;

    __host__ __device__ bool operator<=(const iterator & other) const noexcept;

    __host__ __device__ bool operator>=(const iterator & other) const noexcept;

    __host__ __device__ bool operator==(const iterator & other) const noexcept;

    __host__ __device__ bool operator!=(const iterator & other) const noexcept;

    __host__ __device__ reference operator[](const difference_type & idx) noexcept;
};

}}}

#include "impl/iterator"

SCADA_CUDA_EXPORT_SIMPLE_NS(scada::cuda::mdspan, iterator)
SCADA_CUDA_EXPORT_SIMPLE_NS(scada::cuda, iterator)

#endif
